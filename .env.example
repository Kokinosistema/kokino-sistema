# Copiar este archivo como .env y completar con los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# Cadena de conexión que usa node-pg-migrate para conectarse a PostgreSQL.
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/kokino_dev

# Clave con la que se firman las cookies de sesión. Cada máquina tiene la suya;
# generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=GENERAR_UNA_PROPIA

# Zona horaria del sistema (opcional; por defecto, Tucumán). Así "hoy" y las
# horas de las ventas son las de Argentina aunque el servidor esté en otro país.
# ZONA_HORARIA=America/Argentina/Tucuman

# Base de las pruebas automáticas (opcional). npm test la BORRA y la arma de
# nuevo en cada corrida, así que su nombre tiene que terminar en _prueba. Si no
# se pone, se usa DATABASE_URL con la base kokino_prueba.
# DATABASE_URL_PRUEBA=postgres://postgres:TU_PASSWORD@localhost:5432/kokino_prueba

# --- Solo para publicar en Vercel con Supabase (ver docs/VERCEL-SUPABASE.md) ---
# Estas van en las variables de entorno de Vercel, no en este archivo.
# DATABASE_URL               conexion "transaction" de Supabase (puerto 6543)
# DATABASE_URL_MIGRACIONES   conexion "session" de Supabase (puerto 5432)
# SESSION_SECRET             una clave propia, distinta de la de la compu
