# Copiar este archivo como .env y completar con los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# Cadena de conexión que usa node-pg-migrate para conectarse a PostgreSQL.
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/kokino_dev

# Clave con la que se firman las cookies de sesión. Cada máquina tiene la suya;
# generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=GENERAR_UNA_PROPIA
