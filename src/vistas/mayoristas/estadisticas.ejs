<%- include('../parciales/encabezado', { titulo: 'Estadísticas de mayoristas - Kokino' }) %>

<% const maxMes = Math.max(0, ...meses.map((m) => m.tachos));
   const actual = meses[meses.length - 1];
   const pasado = meses[meses.length - 2]; %>

<a class="volver" href="/clientes">← Clientes mayoristas</a>
<h1>Estadísticas de mayoristas</h1>
<p class="ayuda">Todos los mayoristas juntos, sin contar las ventas anuladas. Sirve para prever qué fabricar.</p>

<%# Que fabricar: el pronostico de las proximas semanas (ver pronosticoPorCliente
    en la ruta para como se calcula). %>
<% const p = pronostico;
   const diaMes = (d) => d.toLocaleDateString('es-AR', { day: 'numeric', month: 'numeric' });
   const tachos = (n) => n + (n === 1 ? ' tacho' : ' tachos');
   const PLAZO_TEXTO = { 7: 'la próxima semana', 14: 'las próximas 2 semanas', 30: 'el próximo mes' };
   const estimados = p.clientes.filter((c) => c.estado === 'ESTIMADO');
   const afuera = p.clientes.filter((c) => c.estado !== 'ESTIMADO');
   const hayArtesanal = p.sabores.some((s) => s.linea === 'ARTESANAL'); %>
<section class="panel" id="que-fabricar">
  <div class="titulo-con-accion">
    <h2>Qué fabricar para los mayoristas</h2>
    <nav class="elegir-plazo" aria-label="Plazo del pronóstico">
      <% p.PLAZOS.forEach(function (d) { %>
        <a class="<%= d === p.dias ? 'boton' : 'boton-secundario' %>" href="/clientes/estadisticas?dias=<%= d %>#que-fabricar"
           <%= d === p.dias ? 'aria-current=true' : '' %>><%= d === 7 ? '1 semana' : d === 14 ? '2 semanas' : '1 mes' %></a>
      <% }) %>
    </nav>
  </div>
  <p class="ayuda">
    Lo que se espera que pidan los mayoristas en <%= PLAZO_TEXTO[p.dias] %>, según cada cuánto compra cada uno y qué lleva
    (sus compras de los últimos 6 meses). Es un promedio: sirve para planificar, no es exacto.
  </p>

  <% if (p.sabores.length === 0) { %>
    <p class="ayuda">No se espera ninguna compra de mayoristas en este plazo.</p>
  <% } else { %>
    <table class="tabla">
      <thead><tr><th>Sabor</th><th class="numero">Se esperan</th><th class="numero">Llenos en <%= fabrica || 'la fábrica' %></th><th class="numero">Fabricar</th></tr></thead>
      <tbody>
        <% p.sabores.forEach(function (s) { %>
          <tr>
            <td><%= s.sabor %><%= s.linea === 'ARTESANAL' ? ' *' : '' %></td>
            <td class="numero">unos <%= s.esperados %></td>
            <td class="numero"><%= s.llenos %></td>
            <td class="numero"><%- s.fabricar > 0 ? '<strong class="alerta">' + tachos(s.fabricar) + '</strong>' : 'Alcanza' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (hayArtesanal) { %>
      <p class="pista">* Los tachos artesanales también se usan en el mostrador: no todos los llenos quedan libres para los mayoristas.</p>
    <% } %>
  <% } %>

  <% if (estimados.length > 0) { %>
    <h3 class="subtitulo-panel">Cliente por cliente</h3>
    <ul class="lista-control">
      <% estimados.forEach(function (c) { const esperados = Math.ceil(c.esperados); %>
        <li>
          <a href="/clientes/<%= c.id_cliente %>"><%= c.nombre_razon_social %></a>:
          <% if (esperados > 0) { %><strong>unos <%= tachos(esperados) %></strong><% } else { %>no le toca comprar en este plazo<% } %>
          <br><span class="pista">
            <%= c.atrasado ? 'Ya debería haber comprado: tocaba alrededor del ' + diaMes(c.proxima) : 'Próxima compra alrededor del ' + diaMes(c.proxima) %>.
            Compra cada <%= c.cada_dias %> <%= c.cada_dias === 1 ? 'día' : 'días' %> y lleva unos <%= tachos(Math.round(c.por_compra)) %>.
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <% if (afuera.length > 0) { %>
    <h3 class="subtitulo-panel">No se cuentan</h3>
    <ul class="lista-control">
      <% afuera.forEach(function (c) { %>
        <li>
          <a href="/clientes/<%= c.id_cliente %>"><%= c.nombre_razon_social %></a>:
          <span class="pista">
            <% if (c.estado === 'NO_VUELVE') { %>
              hace <%= c.dias_desde %> días que no compra, más del doble de lo habitual (cada <%= c.cada_dias %> días).
            <% } else { %>
              tiene una sola compra en los últimos 6 meses: todavía no se puede estimar cada cuánto compra.
            <% } %>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<div class="tarjetas-metricas">
  <article class="tarjeta metrica">
    <h3>Tachos este mes</h3>
    <p class="metrica-valor"><%= actual.tachos %></p>
    <p class="pista"><%= pesos(actual.total) %> · el mes pasado: <%= pasado.tachos %> (<%= pesos(pasado.total) %>)</p>
  </article>
  <article class="tarjeta metrica">
    <h3>Clientes que compraron este mes</h3>
    <p class="metrica-valor"><%= clientes.filter((c) => c.este_mes > 0).length %></p>
    <p class="pista">de <%= clientes.length %> mayoristas activos</p>
  </article>
</div>

<section class="panel">
  <h2>Tachos por mes <span class="pista-inline">(últimos 12 meses)</span></h2>
  <div class="barras" role="list">
    <% meses.forEach(function (m) { %>
      <div class="barra <%= m.esActual ? 'hoy' : '' %>" role="listitem" tabindex="0"
           data-detalle-titulo="<%= m.mes %>" data-detalle-texto="<%= m.tachos %> <%= m.tachos === 1 ? 'tacho' : 'tachos' %>, <%= pesos(m.total) %>">
        <span class="barra-valor"><%= m.tachos || '' %></span>
        <span class="barra-columna"><span style="height: <%= maxMes > 0 ? Math.round((m.tachos / maxMes) * 100) : 0 %>%"></span></span>
        <span class="barra-etiqueta"><%= m.mes %></span>
      </div>
    <% }) %>
  </div>
</section>

<section class="panel">
  <h2>Qué sabores piden <span class="pista-inline">(este mes y los 3 anteriores)</span></h2>
  <% if (sabores.length === 0) { %>
    <p class="ayuda">Todavía no hay ventas mayoristas registradas en estos meses.</p>
  <% } else { %>
    <p class="ayuda">
      Al lado de cada sabor, cuántos tachos llenos hay hoy<%= fabrica ? ' en ' + fabrica : '' %> y para cuánto alcanzan
      al ritmo de los mayoristas (sin contar lo que se vende en el mostrador).
    </p>
    <table class="tabla">
      <thead>
        <tr><th>Sabor</th><th class="numero">Tachos</th><th class="numero">Por mes</th><th class="numero">Este mes</th><th class="numero">Clientes</th><th class="numero">Llenos hoy</th><th>Alcanza para</th></tr>
      </thead>
      <tbody>
        <% sabores.forEach(function (s) {
             const porMes = s.tachos / 4;
             const meses = porMes > 0 ? s.llenos / porMes : null; %>
          <tr>
            <td><%= s.sabor %></td>
            <td class="numero"><%= s.tachos %></td>
            <td class="numero"><%= porMes.toLocaleString('es-AR', { maximumFractionDigits: 1 }) %></td>
            <td class="numero"><%= s.este_mes %></td>
            <td class="numero"><%= s.clientes %></td>
            <td class="numero <%= s.llenos === 0 ? 'alerta' : '' %>"><%= s.llenos %></td>
            <td class="<%= meses !== null && meses < 0.5 ? 'alerta' : '' %>">
              <%= s.llenos === 0 ? 'No hay stock' : meses < 0.5 ? 'Menos de 2 semanas' : meses < 1 ? 'Menos de un mes' : 'Unos ' + Math.floor(meses) + (Math.floor(meses) === 1 ? ' mes' : ' meses') %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<section class="panel">
  <h2>Cómo viene cada cliente</h2>
  <% if (clientes.length === 0) { %>
    <p class="ayuda">No hay mayoristas activos.</p>
  <% } else { %>
    <table class="tabla">
      <thead><tr><th>Cliente</th><th class="numero">Este mes</th><th class="numero">Mes pasado</th><th class="numero">Vendido este mes</th><th>Última compra</th></tr></thead>
      <tbody>
        <% clientes.forEach(function (c) { %>
          <tr>
            <td><a href="/clientes/<%= c.id_cliente %>"><%= c.nombre_razon_social %></a></td>
            <td class="numero"><%= c.este_mes %></td>
            <td class="numero"><%= c.mes_pasado %></td>
            <td class="numero"><%= pesos(c.total_mes) %></td>
            <td><%= c.ultima ? c.ultima.toLocaleDateString('es-AR') : 'Nunca' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('../parciales/pie') %>
