<%- include('../parciales/encabezado', { titulo: 'Venta a ' + cliente.nombre_razon_social + ' - Kokino' }) %>

<a class="volver" href="/clientes/<%= cliente.id_cliente %>">← <%= cliente.nombre_razon_social %></a>
<h1>Venta a <%= cliente.nombre_razon_social %></h1>
<p class="ayuda">
  Los tachos salen del stock de <strong><%= sucursal.nombre %></strong>, los que vencen primero.
  Buscá cada sabor, poné cuántos tachos y el envase, y tocá <strong>Agregar</strong>. El precio viene
  de la lista de precios mayoristas y se puede cambiar.
  <% if (cuenta.deuda > 0) { %><br>Hoy debe <strong><%= pesos(cuenta.deuda) %></strong>.<% } %>
</p>

<% if (errores.length > 0) { %>
  <ul class="errores" role="alert">
    <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<% if (sabores.length === 0) { %>
  <section class="panel">
    <p class="ayuda">No hay tachos llenos en <%= sucursal.nombre %> para vender. Si están en la otra sucursal, cambiala arriba.</p>
  </section>
<% } else { %>
<form method="post" action="/clientes/<%= cliente.id_cliente %>/vender" class="formulario formulario-ancho" id="form-venta" autocomplete="off">
  <input type="hidden" name="id_sucursal" value="<%= sucursal.id_sucursal %>">

  <h3 class="subtitulo-form">Helado</h3>
  <div class="fila fila-agregar">
    <div class="campo-ancho">
      <label for="sabor-texto">Sabor</label>
      <div class="combo" id="combo-sabor">
        <input type="text" id="sabor-texto" class="combo-texto" autocomplete="off"
               role="combobox" aria-expanded="false" aria-controls="sabor-lista" aria-autocomplete="list"
               placeholder="Buscá el sabor (por ejemplo: dulce nuez)">
        <button type="button" class="combo-flecha" aria-label="Mostrar la lista de sabores">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <ul id="sabor-lista" class="combo-lista" role="listbox" hidden>
          <% sabores.forEach(function (s, i) { %>
            <li class="combo-opcion" role="option" id="sabor-opcion-<%= i %>" aria-selected="false"
                data-valor="<%= s.id_sabor %>" data-nombre="<%= s.nombre %>" data-llenos="<%= s.llenos %>" data-linea="<%= s.linea %>">
              <%= s.nombre %> <span class="combo-extra"><%= s.llenos %> <%= s.llenos === 1 ? 'lleno' : 'llenos' %></span>
            </li>
          <% }) %>
          <li class="combo-vacio" role="presentation" hidden>Ningún sabor con tachos llenos coincide con la búsqueda.</li>
        </ul>
      </div>
    </div>
    <div class="campo-corto">
      <label for="tachos-agregar">Tachos <span id="llenos-sabor" class="pista-inline"></span></label>
      <input id="tachos-agregar" class="solo-numeros" inputmode="numeric" maxlength="3" autocomplete="off"
             placeholder="Ej.: 2" data-mensaje="la cantidad de tachos es un número entero.">
    </div>
    <div class="campo-medio">
      <label for="envase-agregar">Envase</label>
      <select id="envase-agregar">
        <% ENVASES.forEach(function (e) { %><option value="<%= e.valor %>"><%= e.texto %></option><% }) %>
      </select>
    </div>
    <div class="campo-boton">
      <button type="button" class="boton-secundario" id="agregar-sabor">Agregar</button>
    </div>
  </div>
  <p class="error-campo" id="error-agregar" role="alert" hidden></p>

  <table class="tabla" id="tabla-van">
    <thead>
      <tr><th>Lo que lleva</th><th>Envase</th><th class="numero">Tachos</th><th class="numero">Precio por tacho</th><th class="numero">Subtotal</th><th></th></tr>
    </thead>
    <tbody>
      <% borrador.renglones.forEach(function (r) {
           const s = sabores.find((x) => x.id_sabor === Number(r.id_sabor));
           const e = ENVASES.find((x) => x.valor === r.envase); %>
        <tr class="renglon" data-sabor="<%= r.id_sabor %>" data-envase="<%= r.envase %>">
          <td><%= s ? s.nombre : 'Sabor sin tachos llenos' %>
            <input type="hidden" name="renglon_sabor" value="<%= r.id_sabor %>">
            <input type="hidden" name="renglon_envase" value="<%= r.envase %>"></td>
          <td><%= e ? e.texto : '' %></td>
          <td class="numero"><input name="renglon_cantidad" class="solo-numeros cantidad-corta" inputmode="numeric" maxlength="3" required
                                    value="<%= r.cantidad %>" aria-label="Tachos" data-mensaje="la cantidad de tachos es un número entero."></td>
          <td class="numero"><input name="renglon_precio" class="dinero precio-renglon" inputmode="decimal" required value="<%= r.precio %>" placeholder="$0" aria-label="Precio por tacho"></td>
          <td class="numero subtotal"></td>
          <td class="acciones"><button type="button" class="enlace quitar">Quitar</button></td>
        </tr>
      <% }) %>
      <tr class="sin-sabores"><td colspan="6" class="ayuda">Todavía no agregaste helado. Buscá el sabor arriba.</td></tr>
    </tbody>
    <tfoot><tr class="total-fila"><td colspan="4">Total</td><td class="numero" id="total-venta">$0</td><td></td></tr></tfoot>
  </table>

  <fieldset class="opciones-boton">
    <legend>Pago</legend>
    <div class="grupo-botones">
      <% PAGOS.forEach(function (p) { %>
        <label class="opcion-boton">
          <input type="radio" name="pago" value="<%= p.valor %>" <%= borrador.pago === p.valor ? 'checked' : '' %> required>
          <span><%= p.texto %></span>
        </label>
      <% }) %>
    </div>
  </fieldset>
  <% if (cliente.limite_cuenta_corriente === null) { %>
    <p class="pista">Este cliente no tiene cuenta corriente habilitada: para venderle a cuenta, cargale un límite en Editar cliente.</p>
  <% } %>

  <fieldset class="opciones-boton" id="medio-pago" <%= borrador.pago === 'AHORA' ? '' : 'hidden' %>>
    <legend>Con qué pagó</legend>
    <div class="grupo-botones">
      <% medios.forEach(function (m) { %>
        <label class="opcion-boton">
          <input type="radio" name="id_medio_pago" value="<%= m.id_medio_pago %>" <%= String(m.id_medio_pago) === String(borrador.id_medio_pago) ? 'checked' : '' %>>
          <span><%= m.nombre %></span>
        </label>
      <% }) %>
    </div>
    <p class="pista">Si pagó una parte, elegí "Queda a cuenta" y registrá lo que pagó desde el remito.</p>
  </fieldset>

  <label for="observaciones">Observaciones <span class="pista-inline">(opcional)</span></label>
  <textarea id="observaciones" name="observaciones" rows="2" maxlength="500" placeholder="Por ejemplo: lo retira el martes"><%= borrador.observaciones %></textarea>

  <div class="botonera">
    <button type="submit">Revisar el remito</button>
    <a class="cancelar" href="/clientes/<%= cliente.id_cliente %>">Cancelar</a>
  </div>
</form>
<% } %>

<script src="/solo-numeros.js"></script>
<script src="/combo-sabores.js"></script>
<script>
  // Armado de la venta: el sabor se elige con la lista con buscador; con los
  // tachos y el envase se agrega a "Lo que lleva", con el precio sugerido de
  // la lista de precios (por linea y envase), que se puede cambiar. Si el
  // sabor ya estaba con ese envase, se cambia su cantidad. El total se
  // recalcula solo. El servidor vuelve a controlar todo al revisar.
  (function () {
    var form = document.getElementById('form-venta');
    if (!form) return;
    var PRECIOS = <%- JSON.stringify(Object.fromEntries(Object.entries(precios).map(([k, v]) => [k, v.precio]))) %>;
    var ENVASES = <%- JSON.stringify(Object.fromEntries(ENVASES.map((e) => [e.valor, e.texto]))) %>;
    var cantidad = document.getElementById('tachos-agregar');
    var envase = document.getElementById('envase-agregar');
    var pistaLlenos = document.getElementById('llenos-sabor');
    var error = document.getElementById('error-agregar');
    var cuerpo = document.querySelector('#tabla-van tbody');
    var sinSabores = cuerpo.querySelector('.sin-sabores');
    var totalVenta = document.getElementById('total-venta');
    var dinero = window.dineroKokino;

    var combo = comboSabores(document.getElementById('combo-sabor'), {
      alElegir: function (o) {
        pistaLlenos.textContent = '(hay ' + o.dataset.llenos + ')';
        mostrarError('');
        cantidad.focus();
        cantidad.select();
      },
      alEscribir: function () { pistaLlenos.textContent = ''; },
    });

    function mostrarError(m) { error.textContent = m ? 'Error: ' + m : ''; error.hidden = !m; }
    function renglones() { return Array.prototype.slice.call(cuerpo.querySelectorAll('tr.renglon')); }

    function recalcular() {
      var total = 0;
      renglones().forEach(function (tr) {
        var n = Number(tr.querySelector('[name=renglon_cantidad]').value) || 0;
        var precio = dinero.centavos(tr.querySelector('[name=renglon_precio]').value);
        var sub = precio === null ? null : n * precio;
        tr.querySelector('.subtotal').textContent = sub === null ? '—' : dinero.pesos(sub);
        if (sub !== null) total += sub;
      });
      totalVenta.textContent = dinero.pesos(total);
      sinSabores.hidden = renglones().length > 0;
    }

    function celda(tr, clase, hijo) {
      var td = document.createElement('td');
      if (clase) td.className = clase;
      if (typeof hijo === 'string') td.textContent = hijo; else if (hijo) td.appendChild(hijo);
      tr.appendChild(td);
      return td;
    }
    function campo(nombre, clase, valor, extra) {
      var i = document.createElement('input');
      i.name = nombre; i.className = clase; i.value = valor; i.required = true;
      for (var k in extra) i.setAttribute(k, extra[k]);
      return i;
    }

    function agregar() {
      var o = combo.elegida();
      if (!o) { mostrarError('elegí un sabor de la lista.'); document.getElementById('sabor-texto').focus(); return; }
      var n = Number(cantidad.value);
      if (!cantidad.value || n < 1) { mostrarError('poné cuántos tachos de ' + o.dataset.nombre + ' lleva.'); cantidad.focus(); return; }
      // Lo que ya lleva de este sabor con el otro envase tambien cuenta.
      var otros = renglones().filter(function (tr) { return tr.dataset.sabor === o.dataset.valor && tr.dataset.envase !== envase.value; })
        .reduce(function (s, tr) { return s + (Number(tr.querySelector('[name=renglon_cantidad]').value) || 0); }, 0);
      var llenos = Number(o.dataset.llenos);
      if (n + otros > llenos) { mostrarError('de ' + o.dataset.nombre + ' hay ' + llenos + (llenos === 1 ? ' tacho lleno.' : ' tachos llenos.')); cantidad.focus(); return; }
      var existente = renglones().find(function (tr) { return tr.dataset.sabor === o.dataset.valor && tr.dataset.envase === envase.value; });
      if (existente) {
        existente.querySelector('[name=renglon_cantidad]').value = n;
      } else {
        var tr = document.createElement('tr');
        tr.className = 'renglon'; tr.dataset.sabor = o.dataset.valor; tr.dataset.envase = envase.value;
        var td = celda(tr, '', o.dataset.nombre);
        var h1 = document.createElement('input'); h1.type = 'hidden'; h1.name = 'renglon_sabor'; h1.value = o.dataset.valor; td.appendChild(h1);
        var h2 = document.createElement('input'); h2.type = 'hidden'; h2.name = 'renglon_envase'; h2.value = envase.value; td.appendChild(h2);
        celda(tr, '', ENVASES[envase.value]);
        celda(tr, 'numero', campo('renglon_cantidad', 'solo-numeros cantidad-corta', String(n),
          { inputmode: 'numeric', maxlength: '3', 'aria-label': 'Tachos', 'data-mensaje': 'la cantidad de tachos es un número entero.' }));
        var sugerido = PRECIOS[o.dataset.linea + ':' + envase.value];
        celda(tr, 'numero', campo('renglon_precio', 'dinero precio-renglon', sugerido === undefined ? '' : dinero.pesos(Math.round(sugerido * 100)),
          { inputmode: 'decimal', placeholder: '$0', 'aria-label': 'Precio por tacho' }));
        celda(tr, 'numero subtotal', '');
        var quitar = document.createElement('button'); quitar.type = 'button'; quitar.className = 'enlace quitar'; quitar.textContent = 'Quitar';
        celda(tr, 'acciones', quitar);
        cuerpo.insertBefore(tr, sinSabores);
        if (sugerido === undefined) {
          mostrarError('no hay precio cargado para esa línea y envase: escribilo en la tabla (o cargalo en Precios mayoristas).');
          tr.querySelector('[name=renglon_precio]').focus();
          recalcular();
          combo.limpiar(); cantidad.value = ''; pistaLlenos.textContent = '';
          return;
        }
      }
      mostrarError('');
      combo.limpiar(); cantidad.value = ''; pistaLlenos.textContent = '';
      recalcular();
      document.getElementById('sabor-texto').focus();
    }

    document.getElementById('agregar-sabor').addEventListener('click', agregar);
    cantidad.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); agregar(); } });
    cuerpo.addEventListener('click', function (e) {
      if (!e.target.classList.contains('quitar')) return;
      e.target.closest('tr').remove();
      recalcular();
    });
    cuerpo.addEventListener('input', recalcular);
    cuerpo.addEventListener('change', recalcular);

    // "Con que pago" solo se pide si pago ahora.
    var medio = document.getElementById('medio-pago');
    form.querySelectorAll('input[name=pago]').forEach(function (r) {
      r.addEventListener('change', function () { medio.hidden = r.value !== 'AHORA' || !r.checked; });
    });

    recalcular();
  })();
</script>

<%- include('../parciales/pie') %>
