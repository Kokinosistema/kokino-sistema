<%- include('../parciales/encabezado', { titulo: 'Precios mayoristas - Kokino' }) %>

<a class="volver" href="/clientes">← Clientes mayoristas</a>
<h1>Precios mayoristas</h1>
<p class="ayuda">
  El precio de un tacho de 10 litros para mayoristas, según la línea y el envase. Es el precio
  sugerido: en cada venta viene puesto y se puede cambiar (por ejemplo, para hacer un descuento
  por cantidad). Un precio nuevo rige desde hoy; las ventas ya hechas conservan el suyo.
</p>

<% if (errores.length > 0) { %>
  <ul class="errores" role="alert">
    <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<form method="post" action="/clientes/precios" class="panel" autocomplete="off">
  <table class="tabla tabla-edicion">
    <thead>
      <tr>
        <th>Línea</th>
        <% ENVASES.forEach(function (e) { %>
          <th class="numero"><%= e.texto %><br><span class="pista-inline"><%= e.ayuda %></span></th>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <% LINEAS.forEach(function (l) { %>
        <tr>
          <td><strong><%= l.texto %></strong></td>
          <% ENVASES.forEach(function (e) {
               const clave = l.valor + ':' + e.valor;
               const vigente = vigentes[clave];
               const valor = valores ? valores[clave] : (vigente ? pesos(vigente.precio) : ''); %>
            <td class="numero">
              <input name="<%= clave %>" type="text" inputmode="decimal" class="dinero" value="<%= valor %>"
                     placeholder="Sin cargar" aria-label="Precio <%= l.texto %> con <%= e.texto.toLowerCase() %>">
              <span class="pista"><%= vigente ? 'Desde el ' + vigente.desde.toLocaleDateString('es-AR') : 'Todavía sin precio' %></span>
            </td>
          <% }) %>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="botonera">
    <button type="submit">Guardar precios</button>
    <a class="cancelar" href="/clientes">Cancelar</a>
  </div>
</form>

<% if (historial.length > 0) { %>
  <section class="panel">
    <h2>Cambios de precio</h2>
    <table class="tabla">
      <thead><tr><th>Línea</th><th>Envase</th><th class="numero">Precio</th><th>Desde</th><th>Hasta</th><th>Cargó</th></tr></thead>
      <tbody>
        <% historial.forEach(function (h) { %>
          <tr class="<%= h.hasta ? 'inactiva' : '' %>">
            <td><%= (LINEAS.find((l) => l.valor === h.linea) || {}).texto %></td>
            <td><%= (ENVASES.find((e) => e.valor === h.envase) || {}).texto %></td>
            <td class="numero"><%= pesos(h.precio) %></td>
            <td><%= h.desde.toLocaleDateString('es-AR') %></td>
            <td><%= h.hasta ? h.hasta.toLocaleDateString('es-AR') : 'vigente' %></td>
            <td><%= h.quien %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<%- include('../parciales/pie') %>
