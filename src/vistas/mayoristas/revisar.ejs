<%- include('../parciales/encabezado', { titulo: 'Revisar venta - Kokino' }) %>

<h1 class="no-imprimir">Revisar la venta</h1>
<p class="ayuda no-imprimir">
  Fijate que esté todo bien. Al confirmar, los tachos salen del stock de <%= sucursal.nombre %>
  <%= borrador.pago === 'CUENTA' ? 'y el total se suma a lo que debe ' + cliente.nombre_razon_social : 'y queda registrado el cobro' %>.
</p>
<% if (superaLimite) { %>
  <p class="aviso-atencion no-imprimir">
    Con esta venta <%= cliente.nombre_razon_social %> debería <%= pesos(cuenta.deuda + total) %>, más que su límite de
    <%= pesos(cliente.limite_cuenta_corriente) %>. Podés confirmarla igual.
  </p>
<% } %>

<%- include('_remito', { remito: {
  numero: null, sucursal: sucursal.nombre, fecha, vendio, cliente, renglones, total,
  pago: borrador.pago === 'AHORA' ? 'pagó ' + pesos(total) + ' con ' + medio.toLowerCase() : 'a cuenta',
  observaciones: borrador.observaciones,
} }) %>

<div class="acciones-ticket no-imprimir">
  <form method="post" action="/clientes/<%= cliente.id_cliente %>/vender/confirmar">
    <button type="submit">Confirmar la venta</button>
  </form>
  <a class="boton-secundario" href="/clientes/<%= cliente.id_cliente %>/vender">Volver a cambiar</a>
</div>

<%- include('../parciales/pie') %>
