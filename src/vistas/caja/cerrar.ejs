<%- include('../parciales/encabezado', { titulo: 'Cerrar caja - Kokino' }) %>

<h1>Cerrar la caja</h1>

<p class="ayuda">
  Turno <%= (TURNOS.find(function (t) { return t.valor === caja.turno; }) || {}).texto %> en <%= caja.sucursal %>,
  abierto el <%= caja.fecha_apertura.toLocaleString('es-AR', { hourCycle: 'h23' }) %>.
</p>

<% if (errores.length > 0) { %>
  <ul class="errores">
    <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<section class="panel">
  <h2>Lo que dice el sistema</h2>

  <table class="tabla">
    <tbody>
      <tr>
        <th>Con lo que se abrió</th>
        <td class="numero"><%= pesos(Number(caja.monto_apertura)) %></td>
      </tr>
      <tr>
        <th>Cobrado en efectivo</th>
        <td class="numero">+ <%= pesos(Number(caja.cobrado_efectivo)) %></td>
      </tr>
      <tr>
        <th>Salidas en efectivo</th>
        <td class="numero">− <%= pesos(Number(caja.egresos_efectivo)) %></td>
      </tr>
      <tr class="destacada">
        <th>Debería haber en caja</th>
        <td class="numero"><%= pesos(esperado) %></td>
      </tr>
    </tbody>
  </table>

  <p class="ayuda">
    <% if (verTodo) { %>
      Los <%= pesos(Number(caja.cobrado_electronico)) %> cobrados con tarjeta
      o transferencia no entran en esta cuenta, porque esa plata no está en el cajón.
    <% } else { %>
      Lo cobrado con tarjeta o transferencia no entra en esta cuenta, porque esa
      plata no está en el cajón.
    <% } %>
  </p>
</section>

<section class="panel">
  <h2>Lo que contaste</h2>

  <p class="ayuda">
    Contá el efectivo que hay de verdad y ponelo acá, aunque no coincida.
    Si hay diferencia el sistema la registra: para eso sirve el arqueo.
  </p>

  <form method="post" action="/caja/cerrar">
    <input type="hidden" name="id_sucursal" value="<%= caja.id_sucursal %>">

    <label>
      Efectivo contado en el cajón
      <input type="text" inputmode="decimal" autocomplete="off" class="dinero" name="monto_cierre_declarado" required
             value="<%= declarado %>" placeholder="$0" autofocus>
    </label>

    <button class="boton" type="submit">Cerrar el turno</button>
    <a class="enlace" href="/caja">Volver sin cerrar</a>
  </form>
</section>

<%- include('../parciales/pie') %>
