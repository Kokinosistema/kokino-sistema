<%- include('../parciales/encabezado', { titulo: 'Nueva cuenta - Kokino' }) %>

<h1>Nueva cuenta</h1>

<% if (errores.length > 0) { %>
  <div class="error" role="alert">
    <% errores.forEach(function (e) { %>
      <p><%= e %></p>
    <% }) %>
  </div>
<% } %>

<% if (empleados.length === 0) { %>
  <p class="ayuda">
    Todos los empleados activos ya tienen cuenta.
    <a href="/usuarios">Volver a la lista</a>
  </p>
<% } else { %>
  <form method="post" action="/usuarios" class="formulario" autocomplete="off">

    <label for="id_empleado">De quien es la cuenta <span class="obligatorio">*</span></label>
    <select id="id_empleado" name="id_empleado" required>
      <option value="">Elegi a la persona</option>
      <% empleados.forEach(function (e) { %>
        <option value="<%= e.id_empleado %>" <%= String(datos.id_empleado) === String(e.id_empleado) ? 'selected' : '' %>>
          <%= (e.nombre + ' ' + e.apellido).trim() %> — <%= e.sucursal %>
        </option>
      <% }) %>
    </select>
    <p class="pista">Solo aparecen los empleados que todavia no tienen cuenta.</p>

    <div class="fila">
      <div>
        <label for="username">Usuario <span class="obligatorio">*</span></label>
        <input id="username" name="username" required value="<%= datos.username %>">
        <p class="pista">Letras, numeros, puntos y guiones. Con el que va a entrar.</p>
      </div>
      <div>
        <label for="id_rol">Rol <span class="obligatorio">*</span></label>
        <select id="id_rol" name="id_rol" required>
          <option value="">Elegi el rol</option>
          <% roles.forEach(function (r) { %>
            <option value="<%= r.id_rol %>" <%= String(datos.id_rol) === String(r.id_rol) ? 'selected' : '' %>>
              <%= r.nombre_rol %>
            </option>
          <% }) %>
        </select>
        <p class="pista">Administrador ve las dos sucursales y configura el sistema.</p>
      </div>
    </div>

    <div class="fila">
      <div>
        <label for="clave">Contrasena <span class="obligatorio">*</span></label>
        <input id="clave" name="clave" type="password" required autocomplete="new-password">
      </div>
      <div>
        <label for="repetida">Repetir contrasena <span class="obligatorio">*</span></label>
        <input id="repetida" name="repetida" type="password" required autocomplete="new-password">
      </div>
    </div>
    <p class="pista">
      Al menos 8 caracteres. Conviene que la persona la cambie despues de entrar
      la primera vez.
    </p>

    <div class="botonera">
      <button type="submit">Crear cuenta</button>
      <a class="cancelar" href="/usuarios">Cancelar</a>
    </div>
  </form>
<% } %>

<%- include('../parciales/pie') %>
