<%- include('../parciales/encabezado', { titulo: 'Cotizar - Kokino' }) %>

<div class="titulo-con-accion">
  <h1>Cotizar</h1>
  <div class="botones-titulo">
    <a class="boton-secundario" href="/clientes/listas">Listas de precios</a>
    <a class="boton-secundario" href="/clientes/nuevo">Agregar cliente mayorista</a>
  </div>
</div>

<p class="ayuda">
  Elegí a quién le cotizás. Cada cliente cotiza con su lista de precios; el que no tiene una
  propia, con la Lista general.
</p>

<% if (clientes.length === 0) { %>
  <p class="ayuda">Todavía no hay clientes mayoristas cargados. Agregá uno para empezar.</p>
<% } else { %>
  <table class="tabla">
    <thead><tr><th>Cliente</th><th>Lista de precios</th><th></th></tr></thead>
    <tbody>
      <% clientes.forEach(function (c) { %>
        <tr>
          <td><a href="/clientes/<%= c.id_cliente %>"><%= c.nombre_razon_social %></a></td>
          <td><%= c.lista %></td>
          <td class="acciones"><a class="boton-secundario" href="/cotizar/<%= c.id_cliente %>">Cotizar</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../parciales/pie') %>
