<%- include('../parciales/encabezado', { titulo: 'Clientes mayoristas - Kokino' }) %>

<div class="titulo-con-accion">
  <h1>Clientes mayoristas</h1>
  <div class="botones-titulo">
    <a class="boton-secundario" href="/clientes/estadisticas">Estadísticas</a>
    <a class="boton-secundario" href="/clientes/listas">Listas de precios</a>
    <a class="boton-secundario" href="/clientes/precios">Precios mayoristas</a>
    <a class="boton" href="/clientes/nuevo">Agregar cliente mayorista</a>
  </div>
</div>

<p class="ayuda">
  Los clientes mayoristas, con su cuenta corriente. La venta de mostrador es
  anónima y no genera cliente. Esta pantalla la ven solo los dueños.
</p>

<% if (clientes.length === 0) { %>
  <p class="ayuda">Todavía no hay clientes mayoristas cargados.</p>
<% } else { %>
  <table class="tabla">
    <thead>
      <tr>
        <th>Cliente</th>
        <th>CUIT</th>
        <th>Telefono</th>
        <% if (puedeCredito) { %>
          <th>Limite cta. cte.</th>
          <th>Plazo</th>
        <% } %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% clientes.forEach(function (c) { %>
        <tr class="<%= c.activo ? '' : 'inactiva' %>">
          <td>
            <a href="/clientes/<%= c.id_cliente %>"><%= c.nombre_razon_social %></a>
            <% if (!c.activo) { %><span class="etiqueta">dado de baja</span><% } %>
          </td>
          <td><%= c.cuit || '—' %></td>
          <td><%= c.telefono || '—' %></td>
          <% if (puedeCredito) { %>
            <td>
              <% if (c.limite_cuenta_corriente === null) { %>
                <span class="pista">sin cuenta corriente</span>
              <% } else { %>
                <%= pesos(c.limite_cuenta_corriente) %>
              <% } %>
            </td>
            <td><%= c.plazo_pago_dias === null ? '—' : c.plazo_pago_dias + ' dias' %></td>
          <% } %>
          <td class="acciones">
            <% if (c.activo) { %><a class="enlace" href="/clientes/<%= c.id_cliente %>/vender">Vender</a><% } %>
            <a class="enlace" href="/clientes/<%= c.id_cliente %>/editar">Editar</a>
            <form method="post" action="/clientes/<%= c.id_cliente %>/baja">
              <input type="hidden" name="activar" value="<%= c.activo ? '0' : '1' %>">
              <button class="enlace" type="submit">
                <%= c.activo ? 'Dar de baja' : 'Reactivar' %>
              </button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<p class="ayuda">
  <% if (mostrarInactivos) { %>
    <a href="/clientes">Ver solo los activos</a>
  <% } else { %>
    <a href="/clientes?inactivos=1">Ver tambien los dados de baja</a>
  <% } %>
</p>

<%- include('../parciales/pie') %>
