<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo : 'Kokino' %></title>
  <link rel="stylesheet" href="/estilos.css">
  <link rel="icon" type="image/png" href="/imagenes/favicon-32.png">
  <%# Va en el head y sin defer: los scripts de cada pantalla usan sus funciones al cargar. %>
  <script src="/dinero.js"></script>
</head>
<body>
<%
  // Iconos de trazo redondeado, como pide el diseño. Van en linea para no
  // depender de una libreria ni de internet.
  const iconos = {
    inicio: '<path d="M4 20V10l8-6 8 6v10"/><path d="M10 20v-6h4v6"/>',
    vender: '<path d="M5 8h14l-1.5 12h-11z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
    caja: '<rect x="3" y="7" width="18" height="12" rx="2"/><circle cx="12" cy="13" r="2.5"/><path d="M7 7V5h10v2"/>',
    clientes: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 5a3 3 0 0 1 0 6M18 20c0-2-1-3.7-2.5-4.8"/>',
    recetas: '<path d="M6 3h9l3 3v15H6z"/><path d="M9 11h6M9 15h6M9 7h3"/>',
    proveedores: '<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>',
    usuarios: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"/>',
    productos: '<path d="M4 7h16v13H4z"/><path d="M4 7l2-3h12l2 3"/><path d="M9 11h6"/>',
    fabricacion: '<path d="M3 20V10l5 3V10l5 3V6h4l1 14z"/><path d="M3 20h18"/>',
    envios: '<rect x="3" y="6" width="11" height="12" rx="1.5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
    mercaderia: '<path d="M4 9l8-4 8 4v8l-8 4-8-4z"/><path d="M12 9v6M9.5 12.5L12 15l2.5-2.5"/>',
    stock: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/>',
    costos: '<circle cx="12" cy="12" r="8.5"/><path d="M14.5 9.2c-.5-.9-1.4-1.4-2.5-1.4-1.5 0-2.6.8-2.6 2s1.1 1.7 2.6 2.1 2.7.9 2.7 2.2-1.2 2.1-2.7 2.1c-1.2 0-2.2-.6-2.7-1.5"/><path d="M12 6.3v1.5M12 16.3v1.4"/>',
    sucursales: '<path d="M4 10l1.5-5h13L20 10"/><path d="M4 10c0 1.4 1.1 2.5 2.7 2.5S9.3 11.4 9.3 10c0 1.4 1.2 2.5 2.7 2.5s2.7-1.1 2.7-2.5c0 1.4 1.1 2.5 2.6 2.5S20 11.4 20 10"/><path d="M5.5 12.3V20h13v-7.7"/><path d="M10 20v-4.5h4V20"/>',
    insumos: '<path d="M4 8l8-4 8 4-8 4z"/><path d="M4 8v8l8 4 8-4V8"/><path d="M12 12v8"/>',
  };
  const svg = (nombre) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + iconos[nombre] + '</svg>';
  const ruta = typeof rutaActual !== 'undefined' ? rutaActual : '';
  const activo = (prefijo) => (prefijo === '/' ? ruta === '/' : ruta.startsWith(prefijo)) ? 'activo' : '';
%>
<% if (usuario) { %>
<div class="app">
  <aside class="lateral">
    <a class="logo" href="/">
      <img src="/imagenes/logo-192.png" alt="Kokino, helados de tradición" width="112" height="112">
    </a>

    <nav class="menu">
      <a class="<%= activo('/') %>" href="/"><%- svg('inicio') %> Inicio</a>
      <a class="<%= activo('/ventas') %>" href="/ventas"><%- svg('vender') %> Vender</a>
      <a class="<%= activo('/caja') %>" href="/caja"><%- svg('caja') %> Caja</a>
      <a class="<%= activo('/fabricacion') %>" href="/fabricacion"><%- svg('fabricacion') %> Fabricación</a>
      <a class="<%= activo('/mercaderia') %>" href="/mercaderia"><%- svg('mercaderia') %> Llegó mercadería</a>
      <a class="<%= activo('/envios') %>" href="/envios"><%- svg('envios') %> Envíos
        <% if (typeof porRecibir !== 'undefined' && porRecibir.length > 0) { %>
          <span class="contador" title="Envíos para recibir"><%= porRecibir.length %><span class="solo-lector"> para recibir</span></span>
        <% } %>
      </a>
      <a class="<%= activo('/recetas') %>" href="/recetas"><%- svg('recetas') %> Recetas</a>
      <% if (usuario.rol === 'administrador') { %>
        <a class="<%= activo('/clientes') %>" href="/clientes"><%- svg('clientes') %> Clientes mayoristas</a>
        <a class="<%= activo('/productos') %>" href="/productos"><%- svg('productos') %> Productos</a>
        <a class="<%= activo('/insumos') %>" href="/insumos"><%- svg('insumos') %> Insumos</a>
        <a class="<%= activo('/costos') %>" href="/costos"><%- svg('costos') %> Costos</a>
        <a class="<%= activo('/proveedores') %>" href="/proveedores"><%- svg('proveedores') %> Proveedores</a>
        <a class="<%= activo('/usuarios') %>" href="/usuarios"><%- svg('usuarios') %> Usuarios</a>
        <a class="<%= activo('/sucursales') %>" href="/sucursales"><%- svg('sucursales') %> Sucursales</a>
      <% } %>
    </nav>

    <p class="pie-lateral">Heladería artesanal<br>San Miguel de Tucumán</p>
  </aside>

  <div class="contenido">
    <header class="cabecera">
      <% if (sucursalesElegibles.length > 1) { %>
        <%# El dueno elige sobre que sucursal trabaja; vale para todas las pantallas. %>
        <form class="elegir-sucursal" method="post" action="/sucursal">
          <input type="hidden" name="volver" value="<%= rutaActual %>">
          <label>
            Sucursal
            <select name="id_sucursal" onchange="this.form.submit()">
              <% sucursalesElegibles.forEach(function (s) { %>
                <option value="<%= s.id_sucursal %>" <%= s.id_sucursal === sucursal.id_sucursal ? 'selected' : '' %>><%= s.nombre %></option>
              <% }) %>
            </select>
          </label>
          <noscript><button type="submit">Cambiar</button></noscript>
        </form>
      <% } else if (sucursal) { %>
        <span class="sucursal"><%= sucursal.nombre %></span>
      <% } %>
      <span class="quien">
        <span class="avatar"><%= (usuario.nombre || '?').charAt(0).toUpperCase() %></span>
        <%= usuario.nombre %>
        <span class="etiqueta"><%= usuario.rol === 'administrador' ? 'dueña/o' : 'empleado' %></span>
      </span>
      <form method="post" action="/logout">
        <button class="salir" type="submit">Salir</button>
      </form>
    </header>
    <main>
<% } else { %>
<div class="pantalla-suelta">
  <div class="caja-suelta">
<% } %>
<% if (typeof aviso !== 'undefined' && aviso) { %>
  <p class="aviso" role="status"><%= aviso %></p>
<% } %>
