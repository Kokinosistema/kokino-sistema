<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo : 'Kokino' %></title>
  <link rel="stylesheet" href="/estilos.css">
  <link rel="icon" type="image/png" href="/imagenes/favicon-32.png">
  <%# Va en el head y sin defer: los scripts de cada pantalla usan sus funciones al cargar. %>
  <script src="/dinero.js"></script>
  <%# Que la pagina quede donde estaba despues de tocar un boton. %>
  <script src="/posicion.js" defer></script>
</head>
<body>
<%
  // Iconos de trazo redondeado, como pide el diseño. Van en linea para no
  // depender de una libreria ni de internet.
  const iconos = {
    inicio: '<path d="M4 20V10l8-6 8 6v10"/><path d="M10 20v-6h4v6"/>',
    vender: '<path d="M5 8h14l-1.5 12h-11z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
    pedidosya: '<circle cx="6" cy="17" r="2.5"/><circle cx="18" cy="17" r="2.5"/><path d="M8.5 17h7l-2-6H9"/><path d="M14 6h2.5l1.5 8.5"/><path d="M3 8h5v3H3z"/>',
    caja: '<rect x="3" y="7" width="18" height="12" rx="2"/><circle cx="12" cy="13" r="2.5"/><path d="M7 7V5h10v2"/>',
    clientes: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 5a3 3 0 0 1 0 6M18 20c0-2-1-3.7-2.5-4.8"/>',
    recetas: '<path d="M6 3h9l3 3v15H6z"/><path d="M9 11h6M9 15h6M9 7h3"/>',
    proveedores: '<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>',
    usuarios: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"/>',
    productos: '<path d="M4 7h16v13H4z"/><path d="M4 7l2-3h12l2 3"/><path d="M9 11h6"/>',
    fabricacion: '<path d="M3 20V10l5 3V10l5 3V6h4l1 14z"/><path d="M3 20h18"/>',
    envios: '<rect x="3" y="6" width="11" height="12" rx="1.5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
    mercaderia: '<path d="M4 9l8-4 8 4v8l-8 4-8-4z"/><path d="M12 9v6M9.5 12.5L12 15l2.5-2.5"/>',
    stock: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/>',
    costos: '<circle cx="12" cy="12" r="8.5"/><path d="M14.5 9.2c-.5-.9-1.4-1.4-2.5-1.4-1.5 0-2.6.8-2.6 2s1.1 1.7 2.6 2.1 2.7.9 2.7 2.2-1.2 2.1-2.7 2.1c-1.2 0-2.2-.6-2.7-1.5"/><path d="M12 6.3v1.5M12 16.3v1.4"/>',
    sucursales: '<path d="M4 10l1.5-5h13L20 10"/><path d="M4 10c0 1.4 1.1 2.5 2.7 2.5S9.3 11.4 9.3 10c0 1.4 1.2 2.5 2.7 2.5s2.7-1.1 2.7-2.5c0 1.4 1.1 2.5 2.6 2.5S20 11.4 20 10"/><path d="M5.5 12.3V20h13v-7.7"/><path d="M10 20v-4.5h4V20"/>',
    insumos: '<path d="M4 8l8-4 8 4-8 4z"/><path d="M4 8v8l8 4 8-4V8"/><path d="M12 12v8"/>',
    historial: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  };
  const svg = (nombre) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + iconos[nombre] + '</svg>';
  const ruta = typeof rutaActual !== 'undefined' ? rutaActual : '';
  const activo = (prefijo) => (prefijo === '/' ? ruta === '/' : ruta.startsWith(prefijo)) ? 'activo' : '';
%>
<% if (usuario) { %>
<div class="app">
  <%# Menu abierto o cerrado: lo recuerda cada navegador (localStorage). Se
      aplica aca, antes de pintar, para que no se vea abrirse y cerrarse. %>
  <script>
    try { if (localStorage.getItem('kokino-menu') === 'cerrado') document.currentScript.parentElement.classList.add('menu-cerrado'); } catch (e) {}
  </script>
  <aside class="lateral">
    <a class="logo" href="/">
      <img src="/imagenes/logo-192.png" alt="Kokino, helados de tradición" width="112" height="112">
    </a>

    <%
      // Menu en grupos desplegables (pedido de la usuaria el 2026-10-07): se
      // ven los nombres de los grupos y, al tocar uno, sus pestanas. Viene
      // abierto el grupo de la pantalla en la que se esta.
      const enGrupo = (prefijos) => prefijos.some((x) => ruta.startsWith(x));
      const grupos = {
        mostrador: enGrupo(['/ventas', '/pedidosya', '/caja']),
        stock: enGrupo(['/fabricacion', '/mercaderia', '/envios', '/recetas', '/stock']),
        negocio: enGrupo(['/historial', '/clientes', '/productos', '/insumos', '/costos', '/proveedores']),
        configuracion: enGrupo(['/usuarios', '/sucursales']),
      };
      const pendientesEnvio = typeof porRecibir !== 'undefined' ? porRecibir.length : 0;
      // Con la barra achicada cada grupo es un icono y sus opciones se abren
      // en un recuadro al costado.
      const iconosGrupo = {
        mostrador: '<path d="M4 10l1.5-5h13L20 10"/><path d="M5.5 10v9h13v-9"/><path d="M4 10h16"/><path d="M10 19v-5h4v5"/>',
        stock: '<path d="M4 8l8-4 8 4-8 4z"/><path d="M4 8v8l8 4 8-4V8"/><path d="M12 12v8"/>',
        negocio: '<path d="M4 4v16h16"/><path d="M8 16v-5M12 16V8M16 16v-3"/>',
        configuracion: '<circle cx="12" cy="12" r="3"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8"/>',
      };
      const cabeceraGrupo = (id, titulo, extra) => '<button type="button" class="grupo-menu' + (grupos[id] ? ' grupo-actual' : '') + '" aria-expanded="' + grupos[id] + '" aria-controls="grupo-' + id + '" title="' + titulo + '">'
        + '<svg class="icono-grupo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + iconosGrupo[id] + '</svg>'
        + '<span class="nombre-grupo">' + titulo + '</span>' + (extra || '')
        + '<svg class="flecha-grupo" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>';
    %>
    <nav class="menu">
      <a class="<%= activo('/') %>" href="/" title="Inicio"><%- svg('inicio') %> <span class="texto-menu">Inicio</span></a>

      <%- cabeceraGrupo('mostrador', 'Mostrador') %>
      <div class="grupo-enlaces" id="grupo-mostrador" <%= grupos.mostrador ? '' : 'hidden' %>>
        <a class="<%= activo('/ventas') %>" href="/ventas" title="Vender"><%- svg('vender') %> <span class="texto-menu">Vender</span></a>
        <a class="<%= activo('/pedidosya') %>" href="/pedidosya" title="Pedidos Ya"><%- svg('pedidosya') %> <span class="texto-menu">Pedidos Ya</span></a>
        <a class="<%= activo('/caja') %>" href="/caja" title="Caja"><%- svg('caja') %> <span class="texto-menu">Caja</span></a>
      </div>

      <%- cabeceraGrupo('stock', 'Stock y fábrica', pendientesEnvio > 0 ? '<span class="contador contador-grupo" title="Envíos para recibir">' + pendientesEnvio + '</span>' : '') %>
      <div class="grupo-enlaces" id="grupo-stock" <%= grupos.stock ? '' : 'hidden' %>>
        <a class="<%= activo('/fabricacion') %>" href="/fabricacion" title="Fabricación"><%- svg('fabricacion') %> <span class="texto-menu">Fabricación</span></a>
        <a class="<%= activo('/mercaderia') %>" href="/mercaderia" title="Llegó mercadería"><%- svg('mercaderia') %> <span class="texto-menu">Llegó mercadería</span></a>
        <a class="<%= activo('/envios') %>" href="/envios" title="Envíos"><%- svg('envios') %> <span class="texto-menu">Envíos</span>
          <% if (pendientesEnvio > 0) { %>
            <span class="contador" title="Envíos para recibir"><%= pendientesEnvio %><span class="solo-lector"> para recibir</span></span>
          <% } %>
        </a>
        <a class="<%= activo('/recetas') %>" href="/recetas" title="Recetas"><%- svg('recetas') %> <span class="texto-menu">Recetas</span></a>
      </div>

      <% if (usuario.rol === 'administrador') { %>
        <%- cabeceraGrupo('negocio', 'Negocio') %>
        <div class="grupo-enlaces" id="grupo-negocio" <%= grupos.negocio ? '' : 'hidden' %>>
          <a class="<%= activo('/historial') %>" href="/historial" title="Historial de ventas"><%- svg('historial') %> <span class="texto-menu">Historial de ventas</span></a>
          <a class="<%= activo('/clientes') %>" href="/clientes" title="Clientes mayoristas"><%- svg('clientes') %> <span class="texto-menu">Clientes mayoristas</span></a>
          <a class="<%= activo('/productos') %>" href="/productos" title="Productos"><%- svg('productos') %> <span class="texto-menu">Productos</span></a>
          <a class="<%= activo('/insumos') %>" href="/insumos" title="Insumos"><%- svg('insumos') %> <span class="texto-menu">Insumos</span></a>
          <a class="<%= activo('/costos') %>" href="/costos" title="Costos"><%- svg('costos') %> <span class="texto-menu">Costos</span></a>
          <a class="<%= activo('/proveedores') %>" href="/proveedores" title="Proveedores"><%- svg('proveedores') %> <span class="texto-menu">Proveedores</span></a>
        </div>

        <%- cabeceraGrupo('configuracion', 'Configuración') %>
        <div class="grupo-enlaces" id="grupo-configuracion" <%= grupos.configuracion ? '' : 'hidden' %>>
          <a class="<%= activo('/usuarios') %>" href="/usuarios" title="Usuarios"><%- svg('usuarios') %> <span class="texto-menu">Usuarios</span></a>
          <a class="<%= activo('/sucursales') %>" href="/sucursales" title="Sucursales"><%- svg('sucursales') %> <span class="texto-menu">Sucursales</span></a>
        </div>
      <% } %>
    </nav>
    <script>
      // Grupos del menu. Con la barra grande, tocar un grupo lo abre y cierra
      // los demas (asi queda corta). Con la barra achicada, abre sus opciones
      // en un recuadro al costado, que se cierra tocando afuera, con Escape o
      // tocando el mismo icono.
      (function () {
        var app = document.querySelector('.app');
        var cabeceras = document.querySelectorAll('.menu .grupo-menu');
        var flotante = null;
        function cerrarFlotante() {
          if (!flotante) return;
          flotante.classList.remove('flotante');
          flotante.style.top = '';
          flotante.style.left = '';
          flotante = null;
        }
        function abrirFlotante(c) {
          var grupo = document.getElementById(c.getAttribute('aria-controls'));
          var r = c.getBoundingClientRect();
          grupo.classList.add('flotante');
          grupo.style.left = (r.right + 8) + 'px';
          // Que no se salga por abajo de la pantalla.
          grupo.style.top = Math.max(8, Math.min(r.top, window.innerHeight - grupo.offsetHeight - 8)) + 'px';
          flotante = grupo;
        }
        cabeceras.forEach(function (c) {
          c.addEventListener('click', function (e) {
            if (app.classList.contains('menu-cerrado')) {
              e.stopPropagation();
              var mismo = flotante && flotante.id === c.getAttribute('aria-controls');
              cerrarFlotante();
              if (!mismo) abrirFlotante(c);
              return;
            }
            var abrir = c.getAttribute('aria-expanded') !== 'true';
            cabeceras.forEach(function (otra) {
              var abierta = otra === c ? abrir : false;
              otra.setAttribute('aria-expanded', abierta ? 'true' : 'false');
              document.getElementById(otra.getAttribute('aria-controls')).hidden = !abierta;
            });
          });
        });
        document.addEventListener('click', function (e) { if (flotante && !flotante.contains(e.target)) cerrarFlotante(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') cerrarFlotante(); });
        window.addEventListener('resize', cerrarFlotante);
        document.querySelector('.menu').addEventListener('scroll', cerrarFlotante);
        // Al agrandar o achicar la barra se cierra el recuadro.
        var boton = document.getElementById('alternar-menu');
        if (boton) boton.addEventListener('click', cerrarFlotante);
        window.cerrarMenuFlotante = cerrarFlotante;
      })();
    </script>

    <p class="pie-lateral">Heladería artesanal<br>San Miguel de Tucumán</p>
  </aside>

  <div class="contenido">
    <header class="cabecera">
      <button type="button" class="alternar-menu" id="alternar-menu" aria-label="Cerrar el menú" title="Cerrar el menú" aria-expanded="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <script>
        // Abre y cierra la franja del menu y lo recuerda en este navegador.
        (function () {
          var app = document.querySelector('.app');
          var boton = document.getElementById('alternar-menu');
          function mostrar() {
            var cerrado = app.classList.contains('menu-cerrado');
            var texto = cerrado ? 'Abrir el menú' : 'Cerrar el menú';
            boton.setAttribute('aria-label', texto);
            boton.title = texto;
            boton.setAttribute('aria-expanded', cerrado ? 'false' : 'true');
          }
          boton.addEventListener('click', function () {
            app.classList.toggle('menu-cerrado');
            try { localStorage.setItem('kokino-menu', app.classList.contains('menu-cerrado') ? 'cerrado' : 'abierto'); } catch (e) {}
            mostrar();
          });
          mostrar();
        })();
      </script>
      <% if (sucursalesElegibles.length > 1) { %>
        <%# El dueno elige sobre que sucursal trabaja; vale para todas las pantallas. %>
        <form class="elegir-sucursal" method="post" action="/sucursal">
          <input type="hidden" name="volver" value="<%= rutaActual %>">
          <label>
            Sucursal
            <select name="id_sucursal" onchange="this.form.submit()">
              <% sucursalesElegibles.forEach(function (s) { %>
                <option value="<%= s.id_sucursal %>" <%= s.id_sucursal === sucursal.id_sucursal ? 'selected' : '' %>><%= s.nombre %></option>
              <% }) %>
            </select>
          </label>
          <noscript><button type="submit">Cambiar</button></noscript>
        </form>
      <% } else if (sucursal) { %>
        <span class="sucursal"><span class="rotulo-sucursal">Sucursal</span> <%= sucursal.nombre %></span>
      <% } %>
      <span class="quien">
        <span class="avatar"><%= (usuario.nombre || '?').charAt(0).toUpperCase() %></span>
        <%= usuario.nombre %>
        <span class="etiqueta"><%= usuario.rol === 'administrador' ? 'dueña/o' : 'empleado' %></span>
      </span>
      <form method="post" action="/logout">
        <button class="salir" type="submit">Salir</button>
      </form>
    </header>
    <main>
<% } else { %>
<div class="pantalla-suelta">
  <div class="caja-suelta">
<% } %>
<% if (typeof aviso !== 'undefined' && aviso) { %>
  <p class="aviso" role="status"><%= aviso %></p>
<% } %>
