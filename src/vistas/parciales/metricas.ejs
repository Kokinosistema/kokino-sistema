<%# Metricas del Inicio, solo para los duenos (la ruta ni las calcula para
    los empleados). Los graficos son barras hechas con HTML y CSS: no
    dependen de ninguna libreria ni de internet. %>
<%
  const m = metricas;
  const fechaCorta = (d) => d.toLocaleDateString('es-AR', { weekday: 'short', day: 'numeric' }).replace('.', '');
  const fechaHora = (f) => f.toLocaleDateString('es-AR', { day: 'numeric', month: 'numeric' }) + ' ' + f.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  const pct = (parte, total) => (total > 0 ? Math.round((parte / total) * 100) : 0);
  const maximo = (lista, campo) => Math.max(0, ...lista.map((x) => x[campo]));
  const TURNOS = { MANANA_TARDE: 'mañana/tarde', TARDE_NOCHE: 'tarde/noche' };
  // Para el numero arriba de cada barra: "$23,5 mil" en vez de "$23.500".
  // Y "$2,9 M" desde el millon, para que entre arriba de una barra angosta.
  const compacto = (n) => (n >= 1000000 ? '$' + (n / 1000000).toLocaleString('es-AR', { maximumFractionDigits: 1 }) + ' M'
    : n >= 1000 ? '$' + (n / 1000).toLocaleString('es-AR', { maximumFractionDigits: 1 }) + ' mil' : pesos(Math.round(n)));
  const mayuscula = (t) => t.charAt(0).toUpperCase() + t.slice(1);
  const cantidad = (n, u) => (Number.isInteger(n) ? n : n.toLocaleString('es-AR', { maximumFractionDigits: 3 })) + ' ' + u;
%>

<section class="metricas" aria-labelledby="titulo-metricas">
  <h2 id="titulo-metricas" class="titulo-metricas">Ventas de <%= sucursal.nombre %></h2>
  <p class="ayuda">Ventas de mostrador, sin contar las anuladas. Las mayoristas están en Clientes mayoristas.</p>

  <div class="tarjetas-metricas">
    <% m.resumen.forEach(function (p) { %>
      <article class="tarjeta metrica">
        <h3><%= p.nombre %></h3>
        <p class="metrica-valor"><%= pesos(p.total) %></p>
        <p class="variacion <%= p.varTotal.clase %>" title="<%= p.contra %>"><%= p.varTotal.texto %></p>
        <dl class="metrica-detalle">
          <div><dt>Ventas</dt><dd><%= p.ventas %> <span class="variacion <%= p.varVentas.clase %>"><%= p.varVentas.clase === 'neutra' ? '' : p.varVentas.texto %></span></dd></div>
          <div><dt>Ticket promedio</dt><dd><%= pesos(Math.round(p.ticket)) %> <span class="variacion <%= p.varTicket.clase %>"><%= p.varTicket.clase === 'neutra' ? '' : p.varTicket.texto %></span></dd></div>
        </dl>
        <p class="pista"><%= p.contra.charAt(0).toUpperCase() + p.contra.slice(1) %>.</p>
      </article>
    <% }) %>
  </div>

  <section class="panel">
    <h2>Últimos 14 días</h2>
    <%# Cada dia con el mismo dia de la semana anterior al lado (la barra clara). %>
    <% const maxDia = Math.max(maximo(m.dias, 'total'), maximo(m.dias, 'anterior'));
       const alto = (v) => (maxDia > 0 ? Math.max(pct(v, maxDia), v > 0 ? 2 : 0) : 0); %>
    <div class="barras" role="list">
      <% m.dias.forEach(function (d) {
           const cambio = d.anterior > 0 ? Math.round(((d.total - d.anterior) / d.anterior) * 100) : null;
           const contra = d.esHoy ? 'el mismo día de la semana pasada a esta hora' : 'el mismo día de la semana anterior';
           const detalle = pesos(d.total) + ' en ' + d.ventas + (d.ventas === 1 ? ' venta' : ' ventas') + '. '
             + (cambio === null ? 'La semana anterior no hubo ventas ese día.' : (cambio > 0 ? '+' : '') + cambio + ' % contra ' + contra + ' (' + pesos(d.anterior) + ').'); %>
        <div class="barra <%= d.esHoy ? 'hoy' : '' %>" role="listitem" tabindex="0"
             data-detalle-titulo="<%= d.esHoy ? 'Hoy, hasta ahora' : mayuscula(d.dia.toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long' })) %>"
             data-detalle-texto="<%= detalle %>">
          <span class="barra-valor"><%= d.total > 0 ? compacto(d.total) : '' %></span>
          <span class="barra-columna con-anterior">
            <span class="anterior" style="height: <%= alto(d.anterior) %>%"></span>
            <span style="height: <%= alto(d.total) %>%"></span>
          </span>
          <span class="barra-etiqueta"><%= d.esHoy ? 'hoy' : fechaCorta(d.dia) %></span>
          <span class="solo-lector"><%= detalle %></span>
        </div>
      <% }) %>
    </div>
    <ul class="leyenda-grafico">
      <li><i style="background: var(--brand-primary)"></i>Ese día</li>
      <li><i style="background: var(--grafico-anterior)"></i>El mismo día de la semana anterior</li>
    </ul>
  </section>

  <div class="grilla-metricas">
    <section class="panel">
      <h2>Las dos sucursales</h2>
      <table class="tabla">
        <thead><tr><th>Sucursal</th><th class="numero">Hoy</th><th class="numero">Esta semana</th></tr></thead>
        <tbody>
          <% m.sucursales.forEach(function (s) { %>
            <tr class="<%= s.id_sucursal === sucursal.id_sucursal ? 'destacada' : '' %>">
              <td><%= s.nombre %></td>
              <td class="numero"><%= pesos(s.hoy_total) %><br><span class="pista"><%= s.hoy_ventas %> <%= s.hoy_ventas === 1 ? 'venta' : 'ventas' %></span></td>
              <td class="numero"><%= pesos(s.semana_total) %><br><span class="pista"><%= s.semana_ventas %> <%= s.semana_ventas === 1 ? 'venta' : 'ventas' %></span></td>
            </tr>
          <% }) %>
          <% if (m.sucursales.length > 1) { %>
            <tr class="total-fila">
              <td>Total</td>
              <td class="numero"><%= pesos(m.sucursales.reduce((a, s) => a + s.hoy_total, 0)) %></td>
              <td class="numero"><%= pesos(m.sucursales.reduce((a, s) => a + s.semana_total, 0)) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </section>

    <section class="panel">
      <h2>Cómo pagan <span class="pista-inline">(últimos 7 días)</span></h2>
      <%# Tortas (2026-10-16): el total y sus partes. El
          color de cada medio sale de su lugar en la lista de medios, que no
          cambia: si hoy no se uso uno, los demas conservan su color. Hay 5
          colores validados; un sexto medio necesita sumar uno a la paleta. %>
      <% const totalMedios = m.semana.medios.reduce((a, x) => a + x.total, 0); %>
      <% if (totalMedios === 0) { %>
        <p class="ayuda">No hubo ventas en los últimos 7 días.</p>
      <% } else { %>
        <%- include('_torta', { partes: m.semana.medios.map((x, i) => ({ nombre: x.nombre, total: x.total, serie: i + 1, detalle: pesos(x.total) })) }) %>
      <% } %>

      <h2 class="subtitulo-panel">Por dónde compran</h2>
      <% const totalCanales = m.semana.canales.reduce((a, x) => a + x.total, 0); %>
      <% if (totalCanales === 0) { %>
        <p class="ayuda">No hubo ventas en los últimos 7 días.</p>
      <% } else { %>
        <%- include('_torta', { partes: m.semana.canales.map((x, i) => ({ nombre: x.nombre, total: x.total, serie: i + 1, detalle: x.ventas + (x.ventas === 1 ? ' venta' : ' ventas') })) }) %>
      <% } %>
    </section>
  </div>

  <section class="panel">
    <h2>Más vendidos <span class="pista-inline">(últimos 7 días)</span></h2>
    <% if (m.semana.masVendidos.length === 0) { %>
      <p class="ayuda">No hubo ventas en los últimos 7 días.</p>
    <% } else { const maxProducto = m.semana.masVendidos[0].total; %>
      <table class="tabla">
        <thead><tr><th></th><th>Producto</th><th class="numero">Cantidad</th><th class="numero">Vendido</th><th class="columna-barra"></th></tr></thead>
        <tbody>
          <% m.semana.masVendidos.forEach(function (x, i) { %>
            <tr>
              <td class="numero puesto"><%= i + 1 %></td>
              <td><%= x.nombre %></td>
              <%# Lo vendido se cuenta por unidad (un termico de 1 kg es una unidad). %>
              <td class="numero"><%= cantidad(x.cantidad, x.cantidad === 1 ? 'unidad' : 'unidades') %></td>
              <td class="numero"><%= pesos(x.total) %></td>
              <td class="columna-barra"><span class="barra-h-pista"><span style="width: <%= pct(x.total, maxProducto) %>%"></span></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section class="panel">
    <h2>Horas pico <span class="pista-inline">(promedio de las últimas 4 semanas)</span></h2>
    <% if (m.pico.horas.length === 0) { %>
      <p class="ayuda">Todavía no hay ventas de días anteriores para calcular las horas pico.</p>
    <% } else {
         // Mapa de calor (2026-10-16): una fila por dia, una columna por hora.
         // Siete tonos de verde: el 0 es "sin ventas" y el 6, el maximo.
         const celdas = [];
         m.pico.filas.forEach((f) => f.celdas.forEach((c) => celdas.push({ ...c, dia: f.nombre })));
         const maxCelda = maximo(celdas, 'promedio');
         const pico = celdas.find((c) => c.promedio === maxCelda);
         const maxDiaSemana = maximo(m.pico.porDia, 'promedio');
         const mejorDia = m.pico.porDia.find((d) => d.promedio === maxDiaSemana);
         const tono = (v) => (v <= 0 ? 0 : Math.min(6, 1 + Math.floor((v / maxCelda) * 6)));
         const franja = (h) => 'de ' + h + ' a ' + ((h + 1) % 24) + ' h'; %>
      <p class="ayuda">
        El momento de más venta es el <strong><%= pico.dia %> <%= franja(pico.hora) %></strong>
        (<%= pesos(Math.round(pico.promedio)) %> en promedio), y el mejor día, el <strong><%= mejorDia.nombre %></strong>.
        Cada casillero es un día a una hora: cuanto más oscuro, más se vende.
      </p>
      <%# Para lectores de pantalla alcanza con la frase de arriba: la grilla
          tiene un casillero por hora y dia, y recorrerlos de a uno no sirve. %>
      <div class="mapa-calor-caja" aria-hidden="true">
        <div class="mapa-calor" style="grid-template-columns: auto repeat(<%= m.pico.horas.length %>, minmax(22px, 1fr))">
          <span></span>
          <% m.pico.horas.forEach(function (h) { %><span class="hora"><%= h %></span><% }) %>
          <% m.pico.filas.forEach(function (f) { %>
            <span class="dia"><%= mayuscula(f.nombre.slice(0, 2)) %></span>
            <% f.celdas.forEach(function (c) { %>
              <span class="celda calor-<%= tono(c.promedio) %><%= c.hora === pico.hora && f.nombre === pico.dia ? ' pico' : '' %>"
                    data-detalle-titulo="<%= mayuscula(f.nombre) %>, <%= franja(c.hora) %>"
                    data-detalle-texto="<%= c.promedio > 0 ? pesos(Math.round(c.promedio)) + ' en promedio' : 'Sin ventas' %>"></span>
            <% }) %>
          <% }) %>
        </div>
      </div>
      <div class="escala-calor" aria-hidden="true">
        <span>Menos</span>
        <span class="tiras"><% for (let i = 0; i <= 6; i++) { %><i class="calor-<%= i %>"></i><% } %></span>
        <span>Más</span>
        <span>· el borde marca el pico</span>
      </div>
    <% } %>
  </section>

  <section class="panel">
    <h2>Control de caja <span class="pista-inline">(últimos 7 días)</span></h2>
    <div class="grilla-metricas">
      <div>
        <h3 class="subtitulo-panel">Ventas anuladas</h3>
        <% if (m.control.anuladas.length === 0) { %>
          <p class="ayuda">No se anuló ninguna venta.</p>
        <% } else { %>
          <p class="ayuda"><%= m.control.anuladas.length %> <%= m.control.anuladas.length === 1 ? 'venta anulada' : 'ventas anuladas' %> por <strong><%= pesos(m.control.totalAnulado) %></strong>.</p>
          <ul class="lista-control">
            <% m.control.anuladas.slice(0, 5).forEach(function (a) { %>
              <li>
                <strong><%= pesos(a.total) %></strong> · venta N° <%= a.id_venta %> de <%= a.vendio %> (<%= fechaHora(a.fecha_hora) %>)<br>
                <span class="pista">Anuló <%= a.anulo %> el <%= fechaHora(a.fecha_anulacion) %>: <%= a.motivo_anulacion %></span>
              </li>
            <% }) %>
            <% if (m.control.anuladas.length > 5) { %>
              <li class="pista">y <%= m.control.anuladas.length - 5 %> más en los últimos 7 días.</li>
            <% } %>
          </ul>
        <% } %>
      </div>
      <div>
        <h3 class="subtitulo-panel">Cierres de caja</h3>
        <% if (m.control.cierres === 0) { %>
          <p class="ayuda">No se cerró ninguna caja.</p>
        <% } else if (m.control.conDiferencia.length === 0) { %>
          <p class="ayuda">Se <%= m.control.cierres === 1 ? 'cerró 1 caja' : 'cerraron ' + m.control.cierres + ' cajas' %> y en todas lo contado coincidió con lo que calculó el sistema.</p>
        <% } else { %>
          <p class="ayuda">De <%= m.control.cierres %> <%= m.control.cierres === 1 ? 'cierre' : 'cierres' %>, <strong><%= m.control.conDiferencia.length %></strong> <%= m.control.conDiferencia.length === 1 ? 'tuvo' : 'tuvieron' %> diferencia entre lo contado y lo que calculó el sistema.</p>
          <ul class="lista-control">
            <% m.control.conDiferencia.forEach(function (c) { %>
              <li>
                <strong class="<%= c.diferencia < 0 ? 'alerta' : '' %>"><%= c.diferencia > 0 ? 'Sobraron ' + pesos(c.diferencia) : 'Faltaron ' + pesos(-c.diferencia) %></strong>
                · turno <%= TURNOS[c.turno] || c.turno %>, cerró <%= c.cerro %> (<%= fechaHora(c.fecha_cierre) %>)<br>
                <span class="pista">Contó <%= pesos(c.declarado) %>; el sistema calculó <%= pesos(c.sistema) %>.</span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>Alertas de stock en <%= sucursal.nombre %></h2>
    <% const a = m.alertas;
       const negativos = a.negativo.productos.length + a.negativo.insumos.length; %>
    <% if (a.pocos.length === 0 && a.porVencer.length === 0 && a.faltantes.length === 0 && negativos === 0) { %>
      <p class="ayuda">No hay alertas: ningún sabor abierto se está quedando sin reserva, nada vence en los próximos 30 días, los envíos llegaron completos y no hay stock en negativo.</p>
    <% } else { %>
      <div class="grilla-metricas">
        <% if (negativos > 0) { %>
          <div>
            <h3 class="subtitulo-panel">Stock en negativo</h3>
            <p class="pista">Se vendió o se usó más de lo que había cargado: falta registrar una compra o un recuento.</p>
            <ul class="lista-control">
              <% a.negativo.productos.forEach(function (x) { %>
                <li><%= x.item %>: <strong class="alerta"><%= cantidad(Number(x.saldo), x.unidad) %></strong></li>
              <% }) %>
              <% a.negativo.insumos.forEach(function (x) { %>
                <li><%= x.item %> <span class="pista-inline">(insumo)</span>: <strong class="alerta"><%= cantidad(Number(x.saldo), x.unidad) %></strong></li>
              <% }) %>
            </ul>
            <p class="pista">
              Corregilo cargando lo contado:
              <% if (a.negativo.productos.length > 0) { %><a class="enlace" href="/productos?cargar=1">stock de productos</a><% } %>
              <% if (a.negativo.productos.length > 0 && a.negativo.insumos.length > 0) { %> · <% } %>
              <% if (a.negativo.insumos.length > 0) { %><a class="enlace" href="/insumos?cargar=1">stock de insumos</a><% } %>
            </p>
          </div>
        <% } %>
        <% if (a.pocos.length > 0) { %>
          <div>
            <h3 class="subtitulo-panel">Se están quedando sin reserva</h3>
            <p class="pista">Sabores con tacho abierto y uno lleno o ninguno para reemplazarlo.</p>
            <ul class="lista-control">
              <% a.pocos.forEach(function (x) { %>
                <li><%= x.sabor %>: <strong class="<%= x.llenos === 0 ? 'alerta' : '' %>"><%= x.llenos === 0 ? 'sin tachos llenos' : '1 tacho lleno' %></strong></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
        <% if (a.porVencer.length > 0) { %>
          <div>
            <h3 class="subtitulo-panel">Vencen pronto</h3>
            <p class="pista">Tachos llenos o abiertos que vencen en los próximos 30 días.</p>
            <ul class="lista-control">
              <% a.porVencer.forEach(function (x) { %>
                <li><%= x.sabor %>: <%= x.tachos %> <%= x.tachos === 1 ? 'tacho' : 'tachos' %>,
                  <strong class="<%= x.vencido ? 'alerta' : '' %>"><%= x.vencido ? 'vencido el ' : 'vence el ' %><%= x.vence.toLocaleDateString('es-AR') %></strong></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
        <% if (a.faltantes.length > 0) { %>
          <div>
            <h3 class="subtitulo-panel">Envíos con faltantes</h3>
            <p class="pista">Envíos de los últimos 30 días que no llegaron completos.</p>
            <ul class="lista-control">
              <% a.faltantes.forEach(function (x) {
                   const partes = [];
                   if (x.tachos > 0) partes.push(x.tachos + (x.tachos === 1 ? ' tacho' : ' tachos'));
                   if (x.productos > 0) partes.push(x.productos + (x.productos === 1 ? ' producto' : ' productos')); %>
                <li><a href="/envios/<%= x.id_traslado %>">Envío N° <%= x.id_traslado %></a> (<%= x.origen %> → <%= x.destino %>): faltó <%= partes.join(' y ') %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </div>
    <% } %>
  </section>
</section>
