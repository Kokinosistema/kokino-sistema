<%# Barra partida: el total y sus partes en una linea, con la leyenda abajo
    (nombre, % y detalle de cada parte, para no depender del color).
    Recibe partes: [{ nombre, total, serie, detalle }]. "serie" es el color
    fijo de esa cosa (1 a 5), el mismo aunque cambie su puesto. %>
<% const totalPartes = partes.reduce((a, x) => a + x.total, 0);
   const porcentaje = (x) => Math.round((x.total / totalPartes) * 100);
   const conVentas = partes.filter((x) => x.total > 0); %>
<div class="barra-partida" aria-hidden="true">
  <% conVentas.forEach(function (x) { %>
    <span class="serie-<%= x.serie %>" style="flex: <%= x.total %>"
          data-detalle-titulo="<%= x.nombre %>" data-detalle-texto="<%= porcentaje(x) %> % · <%= x.detalle %>"></span>
  <% }) %>
</div>
<ul class="leyenda-partida">
  <% conVentas.forEach(function (x) { %>
    <li><i class="serie-<%= x.serie %>"></i><span><%= x.nombre %></span><span class="valor"><%= porcentaje(x) %> % · <%= x.detalle %></span></li>
  <% }) %>
</ul>
