<%# Inicio del empleado: como esta la caja, accesos grandes a lo que usa en
    el turno y el helado que se esta terminando o esta por vencer. %>
<%
  const trazo = {
    vender: '<path d="M5 8h14l-1.5 12h-11z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
    caja: '<rect x="3" y="7" width="18" height="12" rx="2"/><circle cx="12" cy="13" r="2.5"/><path d="M7 7V5h10v2"/>',
    mercaderia: '<path d="M4 9l8-4 8 4v8l-8 4-8-4z"/><path d="M12 9v6M9.5 12.5L12 15l2.5-2.5"/>',
    envios: '<rect x="3" y="6" width="11" height="12" rx="1.5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
    fabricacion: '<path d="M3 20V10l5 3V10l5 3V6h4l1 14z"/><path d="M3 20h18"/>',
  };
  const icono = (n) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + trazo[n] + '</svg>';
  const c = mostrador.caja;
  const a = mostrador.alertas;
%>

<section class="accesos" aria-label="Accesos rápidos">
  <a class="acceso acceso-principal" href="/ventas">
    <span class="icono-acceso"><%- icono('vender') %></span>
    <span class="nombre-acceso">Vender</span>
    <span class="detalle-acceso"><%= c ? (c.ventas === 0 ? 'Todavía no hay ventas en el turno' : c.ventas + (c.ventas === 1 ? ' venta' : ' ventas') + ' en el turno') : 'Primero hay que abrir la caja' %></span>
  </a>
  <a class="acceso <%= c ? '' : 'acceso-alerta' %>" href="/caja">
    <span class="icono-acceso"><%- icono('caja') %></span>
    <span class="nombre-acceso">Caja</span>
    <span class="detalle-acceso">
      <% const hora = c ? c.fecha_apertura.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', hour12: false }) : '';
         const deHoy = c && c.fecha_apertura.toDateString() === new Date().toDateString(); %>
      <%= c ? 'Abierta desde ' + (deHoy ? 'las ' + hora : 'el ' + c.fecha_apertura.toLocaleDateString('es-AR', { day: 'numeric', month: 'numeric' }) + ' a las ' + hora) + ' · ' + c.turno : 'Cerrada: tocá para abrirla' %>
    </span>
  </a>
  <a class="acceso" href="/mercaderia">
    <span class="icono-acceso"><%- icono('mercaderia') %></span>
    <span class="nombre-acceso">Llegó mercadería</span>
    <span class="detalle-acceso">Registrá lo que trae un proveedor</span>
  </a>
  <a class="acceso" href="/envios">
    <span class="icono-acceso"><%- icono('envios') %></span>
    <span class="nombre-acceso">Envíos</span>
    <span class="detalle-acceso"><%= porRecibir.length > 0 ? (porRecibir.length === 1 ? '1 envío para recibir' : porRecibir.length + ' envíos para recibir') : (sucursal.tiene_fabrica ? 'Armar un envío a la otra sucursal' : 'Nada para recibir') %></span>
  </a>
  <a class="acceso" href="/fabricacion">
    <span class="icono-acceso"><%- icono('fabricacion') %></span>
    <span class="nombre-acceso">Helado</span>
    <span class="detalle-acceso">Stock por sabor y cambiar tacho</span>
  </a>
</section>

<section class="panel">
  <h2>Helado en <%= sucursal.nombre %></h2>
  <% if (a.pocos.length === 0 && a.porVencer.length === 0) { %>
    <p class="ayuda">Todo en orden: ningún sabor abierto se está quedando sin reserva y nada vence en los próximos 30 días.</p>
  <% } else { %>
    <div class="grilla-metricas">
      <% if (a.pocos.length > 0) { %>
        <div>
          <h3 class="subtitulo-panel">Se están quedando sin reserva</h3>
          <p class="pista">Sabores con tacho abierto y uno lleno o ninguno para reemplazarlo. Avisá para que manden o fabriquen.</p>
          <ul class="lista-control">
            <% a.pocos.forEach(function (x) { %>
              <li><%= x.sabor %>: <strong class="<%= x.llenos === 0 ? 'alerta' : '' %>"><%= x.llenos === 0 ? 'sin tachos llenos' : '1 tacho lleno' %></strong></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <% if (a.porVencer.length > 0) { %>
        <div>
          <h3 class="subtitulo-panel">Vencen pronto</h3>
          <p class="pista">Conviene usarlos primero.</p>
          <ul class="lista-control">
            <% a.porVencer.forEach(function (x) { %>
              <li><%= x.sabor %>: <%= x.tachos %> <%= x.tachos === 1 ? 'tacho' : 'tachos' %>,
                <strong class="<%= x.vencido ? 'alerta' : '' %>"><%= x.vencido ? 'vencido el ' : 'vence el ' %><%= x.vence.toLocaleDateString('es-AR') %></strong></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>
  <% } %>
</section>
