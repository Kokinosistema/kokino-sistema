<%- include('../parciales/encabezado', { titulo: 'Productos - Kokino' }) %>

<div class="titulo-con-accion">
  <h1>Productos</h1>
  <div class="botones-titulo">
    <a class="boton-secundario" href="/productos/categorias/nueva">Agregar categoría</a>
    <a class="boton" href="/productos/nuevo">Agregar producto</a>
  </div>
</div>

<p class="ayuda">
  Cuánto hay de cada producto en <strong><%= sucursal.nombre %></strong>. Lo que se
  arma al vender (térmicos, cucuruchos, cafés) no aparece acá: lo que se cuenta de eso
  son los envases, los cucuruchos y el café, en <a href="/insumos">Insumos</a>.
</p>

<% grupos.forEach(function (g) { %>
  <section class="panel">
    <h2><%= g.categoria %> <span class="cuantos">· <%= g.productos.length %></span></h2>
    <table class="tabla">
      <thead>
        <tr>
          <th>Producto</th>
          <th class="numero">Stock en <%= sucursal.nombre %></th>
        </tr>
      </thead>
      <tbody>
        <% g.productos.forEach(function (p) { %>
          <tr class="<%= p.activo ? '' : 'inactiva' %>">
            <td>
              <%# El enlace lleva a donde se cargan los insumos del producto. %>
              <a href="/productos/<%= p.id_producto %>"><%= p.nombre %></a>
              <% if (!p.activo) { %><span class="etiqueta">dado de baja</span><% } %>
            </td>
            <td class="numero <%= Number(p.stock) < 0 ? 'alerta' : '' %>"><%= Number(Number(p.stock).toFixed(3)) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% }) %>

<%- include('../parciales/pie') %>
