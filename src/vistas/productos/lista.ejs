<%- include('../parciales/encabezado', { titulo: 'Productos - Kokino' }) %>

<h1>Productos</h1>

<p class="ayuda">
  Qué insumos lleva cada producto. Cada vez que se vende uno, el sistema
  descuenta esos insumos del stock de la sucursal. Un producto sin insumos se
  vende igual, pero no descuenta nada.
</p>
<p class="ayuda">
  Los productos y sus insumos son los mismos para las dos sucursales; el stock
  que se ve es el de <strong><%= sucursal.nombre %></strong>.
</p>

<% if (total > 0) { %>
  <p class="ayuda">
    <strong><%= total - sinInsumos %> de <%= total %></strong> productos tienen sus insumos cargados.
  </p>
  <div class="avance"><div class="avance-lleno" style="width: <%= Math.round(((total - sinInsumos) / total) * 100) %>%"></div></div>
<% } %>

<% grupos.forEach(function (g) { %>
  <section class="panel">
    <h2><%= g.categoria %> <span class="cuantos">· <%= g.productos.length %></span></h2>
    <table class="tabla">
      <thead>
        <tr>
          <th>Producto</th>
          <th>Insumos</th>
          <th class="numero">Stock en <%= sucursal.nombre %></th>
        </tr>
      </thead>
      <tbody>
        <% g.productos.forEach(function (p) { %>
          <tr class="<%= p.activo ? '' : 'inactiva' %>">
            <td>
              <a href="/productos/<%= p.id_producto %>"><%= p.nombre %></a>
              <% if (!p.activo) { %><span class="etiqueta">dado de baja</span><% } %>
            </td>
            <td>
              <% if (p.insumos === 0) { %>
                <span class="pendiente">Sin insumos</span>
              <% } else { %>
                <%= p.insumos %> insumo<%= p.insumos === 1 ? '' : 's' %>
              <% } %>
            </td>
            <%# El stock va a la derecha, donde se mira primero. %>
            <% if (p.lleva_stock_propio) { %>
              <td class="numero <%= Number(p.stock) < 0 ? 'alerta' : '' %>"><%= Number(Number(p.stock).toFixed(3)) %></td>
            <% } else { %>
              <td class="numero"><span class="pista" title="Se arma al vender: descuenta de tachos e insumos">se arma al vender</span></td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% }) %>

<%- include('../parciales/pie') %>
