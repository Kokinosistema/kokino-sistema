<%- include('../parciales/encabezado', { titulo: 'Recibir envío - Kokino' }) %>

<h1>Recibir el envío N° <%= envio.id_traslado %></h1>
<p class="ayuda">
  Controlá la mercadería contra el ticket que viene de <%= envio.origen %>. Destildá los tachos que no
  llegaron y corregí la cantidad de los productos si llegaron menos; en los dos casos escribí qué pasó.
  Si llegó helado o productos que no estaban en el ticket, agregalos abajo.
  Al confirmar, lo que llegó pasa al stock de <%= sucursal.nombre %>.
</p>

<% if (errores.length > 0) { %>
  <ul class="errores" role="alert">
    <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<form method="post" action="/envios/<%= envio.id_traslado %>/recibir" class="formulario formulario-ancho">
  <% if (tachos.length > 0) { %>
    <h2>Helado</h2>
    <table class="tabla">
      <thead><tr><th>Llegó</th><th>Sabor</th><th>Código</th><th>Si no llegó, qué pasó</th></tr></thead>
      <tbody>
        <% tachos.forEach(function (t) { %>
          <tr class="renglon-recepcion">
            <td><input type="checkbox" class="marca-llego" id="llego_<%= t.id_tacho %>" name="llego_<%= t.id_tacho %>" value="1"
                       <%= t.recibido === false ? '' : 'checked' %> aria-label="Llegó el tacho <%= t.codigo_barras %>"></td>
            <td><label for="llego_<%= t.id_tacho %>"><%= t.sabor %></label></td>
            <td><%= t.codigo_barras %></td>
            <td>
              <input name="motivo_tacho_<%= t.id_tacho %>" class="motivo" maxlength="300" value="<%= t.motivo_faltante || '' %>"
                     placeholder="Por ejemplo: no vino en la camioneta" aria-label="Motivo si no llegó el tacho <%= t.codigo_barras %>">
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <% if (productos.length > 0) { %>
    <h2>Productos</h2>
    <table class="tabla">
      <thead><tr><th>Producto</th><th class="numero">Enviados</th><th class="numero">Llegaron</th><th>Si faltó, qué pasó</th></tr></thead>
      <tbody>
        <% productos.forEach(function (p) { %>
          <tr class="renglon-recepcion" data-enviados="<%= Number(p.cantidad) %>">
            <td><label for="recibido_<%= p.id_producto %>"><%= p.nombre %></label></td>
            <td class="numero"><%= Number(p.cantidad) %> <%= p.unidad %></td>
            <td class="numero">
              <input id="recibido_<%= p.id_producto %>" name="recibido_<%= p.id_producto %>" class="solo-numeros cantidad-corta cantidad-llego"
                     inputmode="numeric" maxlength="3" autocomplete="off" required
                     data-mensaje="la cantidad es un número entero."
                     value="<%= p.cantidad_recibida === null || p.cantidad_recibida === undefined ? Number(p.cantidad) : p.cantidad_recibida %>">
            </td>
            <td>
              <input name="motivo_producto_<%= p.id_producto %>" class="motivo" maxlength="300" value="<%= p.motivo_faltante || '' %>"
                     placeholder="Por ejemplo: llegaron rotos" aria-label="Motivo si faltó <%= p.nombre %>">
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <h2>¿Llegó algo que no estaba en el ticket?</h2>

  <h3>Helado</h3>
  <% if (saboresParaAgregar.length > 0) { %>
    <p class="ayuda">Si llegaron tachos de más, elegí el sabor y cuántos. Se descuentan de <%= envio.origen %>: los que vencen primero.</p>
    <div class="agregados">
      <table class="tabla">
        <thead><tr><th>Sabor</th><th class="numero">Tachos</th><th></th></tr></thead>
        <tbody>
          <% (agregados.sabores.length > 0 ? agregados.sabores : [{ id: '', cantidad: '' }]).forEach(function (a) { %>
            <tr class="renglon">
              <td>
                <select name="agregado_sabor" aria-label="Sabor que llegó sin estar en el ticket">
                  <option value="">Elegí el sabor</option>
                  <% saboresParaAgregar.forEach(function (s) { %>
                    <option value="<%= s.id_sabor %>" <%= String(a.id) === String(s.id_sabor) ? 'selected' : '' %>>
                      <%= s.nombre %> · <%= s.llenos %> <%= s.llenos === 1 ? 'disponible' : 'disponibles' %>
                    </option>
                  <% }) %>
                </select>
              </td>
              <td class="numero">
                <input name="agregado_sabor_cantidad" class="solo-numeros cantidad-corta" inputmode="numeric" maxlength="3" autocomplete="off"
                       data-mensaje="la cantidad es un número entero." value="<%= a.cantidad %>" aria-label="Cuántos tachos de ese sabor llegaron de más">
              </td>
              <td class="acciones"><button type="button" class="enlace quitar">Quitar</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <button type="button" class="boton-secundario agregar-renglon">+ Agregar otro sabor</button>
    </div>
  <% } else { %>
    <p class="ayuda">
      En <%= envio.origen %> no quedan tachos llenos cargados en el sistema, así que no hay de dónde descontar.
      Si llegó helado de más, avisales: puede que falte registrar su producción.
    </p>
  <% } %>

  <h3>Productos</h3>
  <% if (productosParaAgregar.length > 0) { %>
    <p class="ayuda">
      Si llegaron productos que no estaban en el ticket, o más de los que dice, elegí el producto y cuánto llegó de más.
      Se descuentan de <%= envio.origen %>.
    </p>
    <div class="agregados">
      <table class="tabla">
        <thead><tr><th>Producto</th><th class="numero">Cantidad</th><th></th></tr></thead>
        <tbody>
          <% (agregados.productos.length > 0 ? agregados.productos : [{ id: '', cantidad: '' }]).forEach(function (a) { %>
            <tr class="renglon">
              <td>
                <select name="agregado_producto" aria-label="Producto que llegó sin estar en el ticket">
                  <option value="">Elegí el producto</option>
                  <% productosParaAgregar.forEach(function (p) { %>
                    <option value="<%= p.id_producto %>" <%= String(a.id) === String(p.id_producto) ? 'selected' : '' %>>
                      <%= p.nombre %> · <%= Number(p.disponible) %> <%= p.unidad %> <%= Number(p.disponible) === 1 ? 'disponible' : 'disponibles' %>
                    </option>
                  <% }) %>
                </select>
              </td>
              <td class="numero">
                <input name="agregado_producto_cantidad" class="solo-numeros cantidad-corta" inputmode="numeric" maxlength="3" autocomplete="off"
                       data-mensaje="la cantidad es un número entero." value="<%= a.cantidad %>" aria-label="Cuánto llegó de más de ese producto">
              </td>
              <td class="acciones"><button type="button" class="enlace quitar">Quitar</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <button type="button" class="boton-secundario agregar-renglon">+ Agregar otro producto</button>
    </div>
  <% } else { %>
    <p class="ayuda">
      En <%= envio.origen %> no hay productos con stock cargado en el sistema, así que no hay de dónde descontar.
      Si llegaron productos de más, avisales: puede que falte registrar su producción.
    </p>
  <% } %>

  <button type="submit">Confirmar lo que llegó</button>
  <a class="boton-secundario" href="/envios/<%= envio.id_traslado %>">Volver</a>
</form>

<script src="/solo-numeros.js"></script>
<script>
  // El motivo se pide solo donde hace falta: en los tachos destildados y en
  // los productos que llegaron menos. En el resto queda deshabilitado.
  (function () {
    document.querySelectorAll('.renglon-recepcion').forEach(function (fila) {
      var motivo = fila.querySelector('.motivo');
      var marca = fila.querySelector('.marca-llego');
      var cantidad = fila.querySelector('.cantidad-llego');
      function actualizar() {
        var falta = marca ? !marca.checked : (cantidad.value !== '' && Number(cantidad.value) < Number(fila.dataset.enviados));
        motivo.disabled = !falta;
        motivo.required = falta;
        fila.classList.toggle('con-faltante', falta);
      }
      (marca || cantidad).addEventListener(marca ? 'change' : 'input', actualizar);
      actualizar();
    });
  })();

  // Renglones de lo que llegó de más (helado y productos), como los
  // ingredientes de una receta: se clona el último vacío. Validar y
  // descontar lo hace el servidor.
  document.querySelectorAll('.agregados').forEach(function (bloque) {
    var cuerpo = bloque.querySelector('tbody');
    var agregar = bloque.querySelector('.agregar-renglon');

    function vaciar(renglon) {
      renglon.querySelector('select').selectedIndex = 0;
      renglon.querySelector('input').value = '';
      renglon.querySelectorAll('.error-campo').forEach(function (cartel) { cartel.remove(); });
      return renglon;
    }

    agregar.addEventListener('click', function () {
      var nuevo = vaciar(cuerpo.querySelector('.renglon:last-child').cloneNode(true));
      cuerpo.appendChild(nuevo);
      nuevo.querySelector('select').focus();
    });

    cuerpo.addEventListener('click', function (evento) {
      if (!evento.target.classList.contains('quitar')) return;
      // Siempre queda un renglón, aunque sea vacío, para tener qué clonar.
      if (cuerpo.querySelectorAll('.renglon').length === 1) {
        vaciar(cuerpo.querySelector('.renglon'));
        return;
      }
      evento.target.closest('.renglon').remove();
    });
  });
</script>

<%- include('../parciales/pie') %>
