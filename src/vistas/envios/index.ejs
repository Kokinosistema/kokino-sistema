<%- include('../parciales/encabezado', { titulo: 'Envíos - Kokino' }) %>

<h1>Envíos</h1>

<% if (errores.length > 0) { %>
  <ul class="errores" role="alert">
    <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<%
  const fecha = (f) => f.toLocaleDateString('es-AR') + ' ' + f.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  const contenido = (e) => {
    const partes = [];
    if (e.tachos > 0) partes.push(e.tachos + (e.tachos === 1 ? ' tacho' : ' tachos'));
    if (e.productos > 0) partes.push(e.productos + (e.productos === 1 ? ' producto' : ' productos'));
    return partes.join(' y ');
  };
  const paraRecibir = enCamino.filter((e) => e.id_sucursal_destino === sucursal.id_sucursal);
  const enviados = enCamino.filter((e) => e.id_sucursal_origen === sucursal.id_sucursal);
%>

<% if (paraRecibir.length > 0) { %>
  <section class="panel">
    <h2>Para recibir en <%= sucursal.nombre %></h2>
    <p class="ayuda">
      Cuando llegue la mercadería, controlala contra el ticket y tocá <strong>Recibir</strong>.
      Recién ahí pasa al stock de <%= sucursal.nombre %>.
    </p>
    <table class="tabla">
      <thead><tr><th>N°</th><th>Desde</th><th>Salió</th><th>Qué trae</th><th></th></tr></thead>
      <tbody>
        <% paraRecibir.forEach(function (e) { %>
          <tr>
            <td><%= e.id_traslado %></td>
            <td><%= e.origen %></td>
            <td><%= fecha(e.fecha_envio) %></td>
            <td><%= contenido(e) %></td>
            <td class="acciones"><a class="boton" href="/envios/<%= e.id_traslado %>/recibir">Recibir</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<% if (puedeArmar) { %>
  <section class="panel">
    <h2>Armar un envío</h2>
    <% if (sabores.length === 0 && productos.length === 0) { %>
      <p class="ayuda">No hay tachos llenos ni productos propios con stock en <%= sucursal.nombre %> para enviar.</p>
    <% } else { %>
      <p class="ayuda">
        Buscá cada sabor o producto, poné cuántos van y tocá <strong>Agregar</strong>. Del helado salen los
        tachos que vencen primero. Después vas a ver el ticket para revisarlo e imprimirlo antes de enviar.
      </p>
      <form method="post" action="/envios/revisar" class="formulario">
        <input type="hidden" name="id_sucursal" value="<%= sucursal.id_sucursal %>">
        <div class="fila">
          <div>
            <label for="id_destino">Va a</label>
            <select id="id_destino" name="id_destino" required>
              <% if (destinos.length !== 1) { %><option value="">Elegí la sucursal</option><% } %>
              <% destinos.forEach(function (d) { %>
                <option value="<%= d.id_sucursal %>" <%= Number(elegido.id_destino) === d.id_sucursal ? 'selected' : '' %>><%= d.nombre %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <% if (sabores.length > 0) { %>
          <%# Helado: se busca el sabor como en Fabricacion (al escribir se
              despliega la lista; la flecha la abre entera), se pone cuantos
              tachos y se agrega a la lista de lo que va. Lo que se envia son
              los campos sabor_<id> de esa lista. %>
          <h3 class="subtitulo-form">Helado</h3>
          <div class="fila fila-agregar">
            <div class="campo-ancho">
              <label for="sabor-texto">Sabor</label>
              <div class="combo" id="combo-sabor">
                <input type="text" id="sabor-texto" class="combo-texto" autocomplete="off"
                       role="combobox" aria-expanded="false" aria-controls="sabor-lista" aria-autocomplete="list"
                       placeholder="Buscá el sabor (por ejemplo: dulce nuez)">
                <button type="button" class="combo-flecha" aria-label="Mostrar la lista de sabores">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <ul id="sabor-lista" class="combo-lista" role="listbox" hidden>
                  <% sabores.forEach(function (s, i) { %>
                    <li class="combo-opcion" role="option" id="sabor-opcion-<%= i %>" aria-selected="false"
                        data-valor="<%= s.id_sabor %>" data-nombre="<%= s.nombre %>" data-tope="<%= s.llenos %>"
                        data-vence="<%= s.vence.toLocaleDateString('es-AR') %>">
                      <%= s.nombre %> <span class="combo-extra"><%= s.llenos %> <%= s.llenos === 1 ? 'lleno' : 'llenos' %></span>
                    </li>
                  <% }) %>
                  <li class="combo-vacio" role="presentation" hidden>Ningún sabor con tachos llenos coincide con la búsqueda.</li>
                </ul>
              </div>
            </div>
            <div class="campo-corto">
              <label for="tachos-agregar">Tachos <span id="llenos-sabor" class="pista-inline"></span></label>
              <input id="tachos-agregar" class="solo-numeros" inputmode="numeric" maxlength="3" autocomplete="off"
                     placeholder="Ej.: 2" data-mensaje="la cantidad de tachos es un número entero.">
            </div>
            <div class="campo-boton">
              <button type="button" class="boton-secundario" id="agregar-sabor">Agregar</button>
            </div>
          </div>
          <p class="error-campo" id="error-agregar" role="alert" hidden></p>

          <table class="tabla" id="tabla-van">
            <thead><tr><th>Lo que va en el envío</th><th class="numero">Llenos</th><th>Vence primero</th><th class="numero">Tachos</th><th></th></tr></thead>
            <tbody>
              <% sabores.forEach(function (s) { if (!elegido.sabores[s.id_sabor]) return; %>
                <tr data-valor="<%= s.id_sabor %>">
                  <td><label for="sabor_<%= s.id_sabor %>"><%= s.nombre %></label></td>
                  <td class="numero"><%= s.llenos %></td>
                  <td><%= s.vence.toLocaleDateString('es-AR') %></td>
                  <td class="numero">
                    <input id="sabor_<%= s.id_sabor %>" name="sabor_<%= s.id_sabor %>" class="solo-numeros cantidad-corta"
                           inputmode="numeric" maxlength="3" autocomplete="off" required
                           data-mensaje="la cantidad de tachos es un número entero." value="<%= elegido.sabores[s.id_sabor] %>">
                  </td>
                  <td class="acciones"><button type="button" class="enlace quitar">Quitar</button></td>
                </tr>
              <% }) %>
              <tr class="sin-sabores"><td colspan="5" class="ayuda">Todavía no agregaste helado. Buscá el sabor arriba.</td></tr>
            </tbody>
          </table>
        <% } %>

        <% if (productos.length > 0) { %>
          <%# Productos propios: igual que el helado. Se busca el producto, se
              pone cuanto y se agrega a la lista; se envian los campos
              producto_<id> de esa lista. %>
          <h3 class="subtitulo-form">Productos propios</h3>
          <div class="fila fila-agregar">
            <div class="campo-ancho">
              <label for="producto-texto">Producto</label>
              <div class="combo" id="combo-producto">
                <input type="text" id="producto-texto" class="combo-texto" autocomplete="off"
                       role="combobox" aria-expanded="false" aria-controls="producto-lista" aria-autocomplete="list"
                       placeholder="Buscá el producto (por ejemplo: alfajor)">
                <button type="button" class="combo-flecha" aria-label="Mostrar la lista de productos">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <ul id="producto-lista" class="combo-lista" role="listbox" hidden>
                  <% productos.forEach(function (p, i) { %>
                    <li class="combo-opcion" role="option" id="producto-opcion-<%= i %>" aria-selected="false"
                        data-valor="<%= p.id_producto %>" data-nombre="<%= p.nombre %>"
                        data-tope="<%= Number(p.disponible) %>" data-unidad="<%= p.unidad %>">
                      <%= p.nombre %> <span class="combo-extra"><%= Number(p.disponible) %> <%= p.unidad %></span>
                    </li>
                  <% }) %>
                  <li class="combo-vacio" role="presentation" hidden>Ningún producto con stock coincide con la búsqueda.</li>
                </ul>
              </div>
            </div>
            <div class="campo-corto">
              <label for="cantidad-producto">Cantidad <span id="disponibles-producto" class="pista-inline"></span></label>
              <input id="cantidad-producto" class="solo-numeros" inputmode="numeric" maxlength="3" autocomplete="off"
                     placeholder="Ej.: 10" data-mensaje="la cantidad es un número entero.">
            </div>
            <div class="campo-boton">
              <button type="button" class="boton-secundario" id="agregar-producto">Agregar</button>
            </div>
          </div>
          <p class="error-campo" id="error-producto" role="alert" hidden></p>

          <table class="tabla" id="tabla-productos-van">
            <thead><tr><th>Productos que van en el envío</th><th class="numero">Disponibles</th><th class="numero">Cantidad</th><th></th></tr></thead>
            <tbody>
              <% productos.forEach(function (p) { if (!elegido.productos[p.id_producto]) return; %>
                <tr data-valor="<%= p.id_producto %>">
                  <td><label for="producto_<%= p.id_producto %>"><%= p.nombre %></label></td>
                  <td class="numero"><%= Number(p.disponible) %> <%= p.unidad %></td>
                  <td class="numero">
                    <input id="producto_<%= p.id_producto %>" name="producto_<%= p.id_producto %>" class="solo-numeros cantidad-corta"
                           inputmode="numeric" maxlength="3" autocomplete="off" required
                           data-mensaje="la cantidad es un número entero." value="<%= elegido.productos[p.id_producto] %>">
                  </td>
                  <td class="acciones"><button type="button" class="enlace quitar">Quitar</button></td>
                </tr>
              <% }) %>
              <tr class="sin-sabores"><td colspan="4" class="ayuda">Todavía no agregaste productos. Buscá el producto arriba.</td></tr>
            </tbody>
          </table>
        <% } %>

        <label for="observaciones">Observaciones <span class="pista-inline">(opcional)</span></label>
        <textarea id="observaciones" name="observaciones" rows="2" maxlength="500"
                  placeholder="Por ejemplo: lo lleva Juan en la camioneta"><%= elegido.observaciones %></textarea>

        <button type="submit">Revisar el ticket</button>
      </form>
    <% } %>
  </section>
<% } else if (paraRecibir.length === 0) { %>
  <p class="ayuda">
    Los envíos se arman en la sucursal donde está la fábrica. Cuando te manden uno a
    <strong><%= sucursal.nombre %></strong>, aparece acá para recibirlo.
  </p>
<% } %>

<% if (enviados.length > 0) { %>
  <section class="panel">
    <h2>En camino</h2>
    <p class="ayuda">Salieron de <%= sucursal.nombre %> y todavía no los recibieron. Mientras tanto se pueden cancelar desde el ticket.</p>
    <table class="tabla">
      <thead><tr><th>N°</th><th>Va a</th><th>Salió</th><th>Qué lleva</th><th></th></tr></thead>
      <tbody>
        <% enviados.forEach(function (e) { %>
          <tr>
            <td><%= e.id_traslado %></td>
            <td><%= e.destino %></td>
            <td><%= fecha(e.fecha_envio) %></td>
            <td><%= contenido(e) %></td>
            <td class="acciones"><a class="enlace" href="/envios/<%= e.id_traslado %>">Ver ticket</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<% if (ultimos.length > 0) { %>
  <section class="panel">
    <h2>Últimos envíos</h2>
    <table class="tabla">
      <thead><tr><th>N°</th><th>Desde</th><th>Hacia</th><th>Salió</th><th>Qué llevaba</th><th>Cómo terminó</th><th></th></tr></thead>
      <tbody>
        <% ultimos.forEach(function (e) { %>
          <tr>
            <td><%= e.id_traslado %></td>
            <td><%= e.origen %></td>
            <td><%= e.destino %></td>
            <td><%= fecha(e.fecha_envio) %></td>
            <td><%= contenido(e) %></td>
            <td>
              <% if (e.estado === 'CANCELADO') { %>Cancelado
              <% } else if (e.faltantes > 0) { %><span class="alerta">Recibido con faltantes</span>
              <% } else { %>Recibido<% } %>
            </td>
            <td class="acciones"><a class="enlace" href="/envios/<%= e.id_traslado %>">Ver ticket</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<script src="/solo-numeros.js"></script>
<script src="/combo-sabores.js"></script>
<script>
  // Helado y productos del envio, con la lista con buscador de las otras
  // pantallas (combo-sabores.js). Elegido el sabor o el producto se pone
  // cuanto va y "Agregar" (o Enter) lo suma a su tabla de lo que va en el
  // envio. Si ya estaba, se cambia su cantidad. El servidor vuelve a
  // controlar todo al revisar.
  //
  // Lo que cambia entre helado y productos va en la configuracion: los
  // elementos de la pagina, el prefijo del campo que se envia (sabor_ o
  // producto_), las columnas de la tabla y los textos.
  function agregador(cfg) {
    var elemento = document.getElementById(cfg.combo);
    if (!elemento) return;
    var texto = elemento.querySelector('.combo-texto');
    var cantidad = document.getElementById(cfg.cantidad);
    var pista = document.getElementById(cfg.pista);
    var error = document.getElementById(cfg.error);
    var cuerpo = document.querySelector('#' + cfg.tabla + ' tbody');
    var vacio = cuerpo.querySelector('.sin-sabores');
    var combo = comboSabores(elemento, {
      alElegir: function (o) {
        pista.textContent = '(hay ' + cfg.disponible(o) + ')';
        mostrarError('');
        // Lo que hubiera en la cantidad queda seleccionado: lo que se escribe lo reemplaza.
        cantidad.focus(); cantidad.select();
      },
      alEscribir: function () { pista.textContent = ''; },
    });

    function mostrarError(m) { error.textContent = m ? 'Error: ' + m : ''; error.hidden = !m; }
    function actualizarVacio() { vacio.hidden = cuerpo.querySelectorAll('tr[data-valor]').length > 0; }

    function celda(contenido, clase) {
      var td = document.createElement('td');
      if (clase) td.className = clase;
      if (typeof contenido === 'string') td.textContent = contenido; else td.appendChild(contenido);
      return td;
    }

    function renglonNuevo(o, n) {
      var tr = document.createElement('tr');
      tr.dataset.valor = o.dataset.valor;
      var etiqueta = document.createElement('label');
      etiqueta.htmlFor = cfg.prefijo + o.dataset.valor;
      etiqueta.textContent = o.dataset.nombre;
      tr.appendChild(celda(etiqueta));
      cfg.columnas(o).forEach(function (c) { tr.appendChild(celda(c.texto, c.numero ? 'numero' : '')); });
      var campo = document.createElement('input');
      campo.id = campo.name = cfg.prefijo + o.dataset.valor;
      campo.className = 'solo-numeros cantidad-corta';
      campo.inputMode = 'numeric'; campo.maxLength = 3; campo.autocomplete = 'off'; campo.required = true;
      campo.dataset.mensaje = cfg.mensajeCampo;
      campo.value = n;
      tr.appendChild(celda(campo, 'numero'));
      var quitar = document.createElement('button');
      quitar.type = 'button'; quitar.className = 'enlace quitar'; quitar.textContent = 'Quitar';
      tr.appendChild(celda(quitar, 'acciones'));
      cuerpo.insertBefore(tr, vacio);
    }

    function agregar() {
      var o = combo.elegida();
      if (!o) { mostrarError(cfg.sinElegir); texto.focus(); return; }
      var n = Number(cantidad.value);
      if (!cantidad.value || n < 1) { mostrarError(cfg.sinCantidad(o)); cantidad.focus(); return; }
      if (n > Number(o.dataset.tope)) { mostrarError(cfg.deMas(o)); cantidad.focus(); return; }
      var existente = document.getElementById(cfg.prefijo + o.dataset.valor);
      if (existente) existente.value = n; else renglonNuevo(o, n);
      actualizarVacio();
      mostrarError('');
      combo.limpiar(); cantidad.value = ''; pista.textContent = '';
      texto.focus();
    }

    cantidad.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); agregar(); }
    });
    document.getElementById(cfg.boton).addEventListener('click', agregar);

    cuerpo.addEventListener('click', function (e) {
      if (!e.target.classList.contains('quitar')) return;
      e.target.closest('tr').remove();
      actualizarVacio();
    });

    actualizarVacio();
  }

  agregador({
    combo: 'combo-sabor', cantidad: 'tachos-agregar', pista: 'llenos-sabor', boton: 'agregar-sabor',
    error: 'error-agregar', tabla: 'tabla-van', prefijo: 'sabor_',
    mensajeCampo: 'la cantidad de tachos es un número entero.',
    disponible: function (o) { return o.dataset.tope; },
    columnas: function (o) { return [{ texto: o.dataset.tope, numero: true }, { texto: o.dataset.vence }]; },
    sinElegir: 'elegí un sabor de la lista.',
    sinCantidad: function (o) { return 'poné cuántos tachos de ' + o.dataset.nombre + ' van.'; },
    deMas: function (o) {
      var llenos = Number(o.dataset.tope);
      return 'de ' + o.dataset.nombre + ' hay ' + llenos + (llenos === 1 ? ' tacho lleno.' : ' tachos llenos.');
    },
  });

  agregador({
    combo: 'combo-producto', cantidad: 'cantidad-producto', pista: 'disponibles-producto', boton: 'agregar-producto',
    error: 'error-producto', tabla: 'tabla-productos-van', prefijo: 'producto_',
    mensajeCampo: 'la cantidad es un número entero.',
    disponible: function (o) { return o.dataset.tope + ' ' + o.dataset.unidad; },
    columnas: function (o) { return [{ texto: o.dataset.tope + ' ' + o.dataset.unidad, numero: true }]; },
    sinElegir: 'elegí un producto de la lista.',
    sinCantidad: function (o) { return 'poné cuánto de ' + o.dataset.nombre + ' va.'; },
    deMas: function (o) { return 'de ' + o.dataset.nombre + ' hay ' + o.dataset.tope + ' ' + o.dataset.unidad + ' disponibles.'; },
  });
</script>

<%- include('../parciales/pie') %>
