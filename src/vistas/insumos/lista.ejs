<%- include('../parciales/encabezado', { titulo: 'Insumos - Kokino' }) %>

<div class="titulo-con-accion">
  <h1>Insumos</h1>
  <div class="botones-titulo">
    <% if (!cargar) { %><a class="boton-secundario" href="/insumos?cargar=1">Cargar stock</a><% } %>
    <a class="boton" href="/insumos/nuevo">Agregar insumo</a>
  </div>
</div>

<p class="ayuda">
  Lo que se compra para producir o para armar lo que se vende: materia prima,
  cucuruchos, envases, térmicos vacíos, cafetería. La unidad es la de compra:
  el stock se cuenta en esa unidad.
</p>
<p class="ayuda">
  La lista de insumos es la misma para las dos sucursales; el stock que se ve
  es el de <strong><%= sucursal.nombre %></strong>. Lo que llega de los proveedores se
  registra en <a href="/mercaderia">Llegó mercadería</a>; para cargar lo que ya hay o
  corregir un recuento, tocá <strong>Cargar stock</strong>.
</p>

<% if (cargar) { %>
  <%# Modo carga: un campo por insumo para escribir cuanto hay contado. %>
  <p class="aviso-atencion">
    Escribí cuánto hay contado en <strong><%= sucursal.nombre %></strong> solo en lo que quieras cargar o
    corregir; lo que dejes vacío no cambia. El sistema registra la diferencia con lo que tenía.
  </p>
  <% if (erroresContado.length > 0) { %>
    <ul class="errores" role="alert"><% erroresContado.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
  <% } %>
  <form method="post" action="/stock/contado/insumo" autocomplete="off" id="form-contado">
    <input type="hidden" name="id_sucursal" value="<%= sucursal.id_sucursal %>">
    <div class="botonera botonera-arriba">
      <button type="submit">Guardar lo contado</button>
      <a class="cancelar" href="/insumos">Cancelar</a>
    </div>
<% } %>

<% if (grupos.length === 0) { %>
  <p class="ayuda">Todavía no hay insumos. Agregá el primero con el botón de arriba.</p>
<% } %>

<% grupos.forEach(function (g) { %>
  <section class="panel">
    <div class="titulo-con-accion">
      <h2><%= g.categoria %> <span class="cuantos">· <%= g.insumos.length %></span></h2>
    </div>
    <table class="tabla">
      <thead>
        <tr>
          <th>Insumo</th>
          <th>Se compra en</th>
          <th class="numero">Stock en <%= sucursal.nombre %></th>
          <% if (cargar) { %><th class="numero">Hay contado</th><% } else { %>
          <th class="numero">Stock mínimo</th>
          <th>Se usa en</th>
          <th></th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% g.insumos.forEach(function (i) { %>
          <tr class="<%= i.activo ? '' : 'inactiva' %>">
            <td>
              <a href="/insumos/<%= i.id_insumo %>/editar"><%= i.nombre %></a>
              <% if (i.perecedero) { %><span class="etiqueta">perecedero</span><% } %>
              <% if (!i.activo) { %><span class="etiqueta">dado de baja</span><% } %>
            </td>
            <td><%= i.unidad %></td>
            <% const stock = Number(i.stock); %>
            <%# En rojo si falta: negativo, o por debajo del minimo cuando hay minimo. %>
            <td class="numero <%= stock < 0 || (Number(i.stock_minimo) > 0 && stock < Number(i.stock_minimo)) ? 'alerta' : '' %>">
              <%= Number(stock.toFixed(3)) %> <%= i.unidad %>
            </td>
<% if (cargar) { const f = paraContar[i.id_insumo]; %>
              <td class="numero">
                <% if (f) { const clave = 'insumo_' + f.id; %>
                  <input name="<%= clave %>" class="cantidad-corta contado" inputmode="decimal" value="<%= valores[clave] || '' %>"
                         placeholder="<%= f.entero ? 'Ej.: 12' : 'Ej.: 2,5' %>" aria-label="Hay contado de <%= i.nombre %>">
                  <span class="pista-inline"><%= f.unidad %></span>
                <% } else { %><span class="pista">dado de baja</span><% } %>
              </td>
            <% } else { %>
            <td class="numero"><%= Number(i.stock_minimo) %> <%= i.unidad %></td>
            <td>
              <% const usos = []; %>
              <% if (i.en_productos) usos.push(i.en_productos + ' producto' + (i.en_productos === 1 ? '' : 's')); %>
              <% if (i.en_recetas) usos.push(i.en_recetas + ' receta' + (i.en_recetas === 1 ? '' : 's')); %>
              <%= usos.length ? usos.join(', ') : '—' %>
            </td>
            <td class="acciones">
              <form method="post" action="/insumos/<%= i.id_insumo %>/baja">
                <input type="hidden" name="activar" value="<%= i.activo ? '0' : '1' %>">
                <button class="enlace" type="submit"><%= i.activo ? 'Dar de baja' : 'Reactivar' %></button>
              </form>
            </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% }) %>

<% if (cargar) { %>
    <div class="botonera">
      <button type="submit">Guardar lo contado</button>
      <a class="cancelar" href="/insumos">Cancelar</a>
    </div>
  </form>
<% } %>

<p class="ayuda">
  <% if (mostrarInactivos) { %>
    <a href="/insumos">Ver solo los activos</a>
  <% } else { %>
    <a href="/insumos?inactivos=1">Ver también los dados de baja</a>
  <% } %>
</p>

<%- include('../parciales/pie') %>
