<%- include('../parciales/encabezado', { titulo: 'Anular venta - Kokino' }) %>

<h1>Anular una venta</h1>

<p class="ayuda">
  Venta por <%= (CANALES.find(function (c) { return c.valor === venta.canal_venta; }) || {}).texto.toLowerCase() %>
  del <%= venta.fecha_hora.toLocaleString('es-AR') %>.
  Al anularla el stock vuelve solo. La venta no se borra: queda en la lista
  marcada como anulada, con tu nombre y el motivo.
</p>

<% if (errores.length > 0) { %>
  <ul class="errores">
    <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<section class="panel">
  <h2>Qué se vendió</h2>
  <table class="tabla">
    <thead>
      <tr>
        <th>Producto</th>
        <th class="numero">Cantidad</th>
        <th class="numero">Precio</th>
        <th class="numero">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      <% lineas.forEach(function (l) { %>
        <tr>
          <td><%= l.nombre %></td>
          <td class="numero"><%= Number(l.cantidad) %></td>
          <td class="numero">$<%= Number(l.precio).toFixed(2) %></td>
          <td class="numero">$<%= Number(l.subtotal).toFixed(2) %></td>
        </tr>
      <% }) %>
      <tr class="destacada">
        <th colspan="3">Total</th>
        <td class="numero">$<%= Number(venta.total).toFixed(2) %></td>
      </tr>
    </tbody>
  </table>

  <% if (pagos.length > 0) { %>
    <p class="ayuda">
      Se cobró con
      <%= pagos.map(function (p) { return p.medio + ' ($' + Number(p.monto).toFixed(2) + ')'; }).join(', ') %>.
      <% if (pagos.some(function (p) { return p.afecta_caja_efectivo; })) { %>
        Lo cobrado en efectivo hay que devolverlo del cajón.
      <% } %>
      <% if (pagos.some(function (p) { return !p.afecta_caja_efectivo; })) { %>
        Lo cobrado con tarjeta o transferencia se devuelve por el mismo medio.
      <% } %>
    </p>
  <% } %>
</section>

<section class="panel">
  <h2>Por qué se anula</h2>
  <form method="post" action="/ventas/<%= venta.id_venta %>/anular">
    <label>
      Motivo <span class="obligatorio">*</span>
      <textarea name="motivo" rows="3" maxlength="<%= MOTIVO_MAXIMO %>" required
                placeholder="Por ejemplo: se cargaron 12 en vez de 2" autofocus><%= motivo %></textarea>
    </label>
    <p class="pista">Queda guardado para que los dueños puedan entender la anulación sin preguntar.</p>

    <div class="botonera">
      <button type="submit">Anular la venta</button>
      <a class="enlace" href="/ventas?sucursal=<%= venta.id_sucursal %>">Volver sin anular</a>
    </div>
  </form>
</section>

<%- include('../parciales/pie') %>
