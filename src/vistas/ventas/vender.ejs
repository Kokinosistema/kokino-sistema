<%- include('../parciales/encabezado', { titulo: 'Vender - Kokino' }) %>
<%
  // Un icono por categoria, con el mismo trazo que el menu. Van por nombre
  // porque las categorias las carga una migracion y casi no cambian; una
  // categoria nueva aparece con el generico hasta que se le dibuje el suyo.
  const trazos = {
    'Cafetería': '<path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M17 10.5h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3.5v2.5M12.5 3.5v2.5"/>',
    'Cucuruchos': '<circle cx="12" cy="8" r="4.5"/><path d="M7.9 10.2 12 21l4.1-10.8"/><path d="M9.5 14h5"/>',
    'Familiar': '<path d="M4 8.5h16"/><path d="M5.5 8.5 7 20h10l1.5-11.5"/><path d="M6.5 8.5c0-2.5 2.5-4 5.5-4s5.5 1.5 5.5 4"/>',
    'Impulsivos': '<rect x="7" y="3" width="10" height="13" rx="5"/><path d="M12 16v5"/><path d="M10 7.5v4"/>',
    'Línea diet': '<path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14z"/><path d="M5 19l8-8"/>',
    'Repostería': '<path d="M4 20h16v-7H4z"/><path d="M4 16c2 1.5 4 1.5 6 0s4-1.5 6 0 3 1 4 0"/><path d="M12 13V9.5"/><path d="M12 7c.9-.9.9-1.9 0-3-.9 1.1-.9 2.1 0 3z"/>',
    'Salsas': '<path d="M12 3c3 4.5 6 7.8 6 11a6 6 0 0 1-12 0c0-3.2 3-6.5 6-11z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>',
    'Térmicos': '<rect x="6" y="7" width="12" height="14" rx="2"/><path d="M5 7h14"/><path d="M9.5 3.5h5V7h-5z"/><path d="M9 12h6"/>',
  };
  const generico = '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>';
  const iconoCategoria = (nombre) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + (trazos[nombre] || generico) + '</svg>';
%>

<h1>Vender</h1>

<% if (errores.length > 0) { %>
  <ul class="errores">
    <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<% if (!caja) { %>
  <section class="panel">
    <h2>No hay caja abierta</h2>
    <p class="ayuda">
      Para vender tiene que haber una caja abierta en esta sucursal: cada venta
      queda registrada en el turno de una caja.
    </p>
    <a class="boton" href="/caja">Ir a abrir la caja</a>
  </section>
<% } else { %>
  <div class="venta">
    <section class="catalogo-venta">
      <% if (!abierta) { %>
        <%# Busqueda general: al escribir se esconden las categorias y aparecen
            los productos que coinciden, de todas las categorias. %>
        <input type="search" id="buscar-todo" class="buscar buscar-todo" value="<%= busqueda %>"
               placeholder="Buscá cualquier producto (por ejemplo: alfajor o palito)"
               aria-label="Buscar cualquier producto" autocomplete="off">
        <div id="resultados-busqueda" hidden>
          <h2>Resultados</h2>
          <p id="sin-resultados-todo" class="ayuda" hidden>Ningún producto coincide con la búsqueda.</p>
          <div class="productos">
            <% catalogo.forEach(function (g) { g.productos.forEach(function (p) { %>
              <%- include('_tarjeta', { p, categoria: '', mostrarCategoria: true }) %>
            <% }) }) %>
          </div>
        </div>

        <div id="inicio-vender">
        <% if (masVendidos.length > 0) { %>
          <h2>Lo más vendido</h2>
          <div class="productos mas-vendidos">
            <% masVendidos.forEach(function (p) { %>
              <%- include('_tarjeta', { p, categoria: '', mostrarCategoria: true }) %>
            <% }) %>
          </div>
        <% } %>
        <h2>¿Qué va a llevar?</h2>
        <div class="categorias">
          <% catalogo.forEach(function (grupo) { %>
            <a class="categoria" href="/ventas?categoria=<%= grupo.id_categoria %>">
              <span class="icono-categoria"><%- iconoCategoria(grupo.categoria) %></span>
              <span class="nombre-categoria"><%= grupo.categoria %></span>
              <span class="cuantos">
                <%= grupo.productos.length === 0 ? 'Sin productos todavía' : grupo.productos.length + ' producto' + (grupo.productos.length === 1 ? '' : 's') %>
              </span>
            </a>
          <% }) %>
          <% if (esDueno) { %>
            <%# Solo los duenos: agregar categorias es configuracion del negocio. %>
            <a class="categoria categoria-nueva" href="/productos/categorias/nueva?volver=ventas">
              <span class="icono-categoria">+</span>
              <span class="nombre-categoria">Agregar categoría</span>
              <span class="cuantos">Y después sus productos</span>
            </a>
          <% } %>
        </div>
        </div>
      <% } else { %>
        <div class="titulo-categoria">
          <a class="volver" href="/ventas">← Categorías</a>
          <div class="titulo-con-accion">
            <h2>
              <span class="icono-categoria chico"><%- iconoCategoria(abierta.categoria) %></span>
              <%= abierta.categoria %>
            </h2>
            <% if (esDueno) { %>
              <%# Solo los administradores: agregar y editar productos es configuracion. %>
              <div class="botones-apilados">
                <a class="boton-secundario" href="/productos/nuevo?categoria=<%= abierta.id_categoria %>&volver=ventas">+ Agregar producto</a>
                <% if (abierta.productos.length > 0) { %>
                  <a class="boton-secundario" href="/productos/categorias/<%= abierta.id_categoria %>/editar?volver=ventas">Editar productos</a>
                <% } %>
              </div>
            <% } %>
          </div>
          <input type="search" id="buscar-producto" class="buscar" value="<%= busqueda %>"
                 placeholder="Buscar en <%= abierta.categoria %> por nombre"
                 aria-label="Buscar producto por nombre" autocomplete="off">
        </div>
        <p id="sin-resultados" class="ayuda" hidden>Ningún producto de esta categoría coincide con la búsqueda.</p>
        <% if (abierta.productos.length === 0) { %>
          <p class="ayuda">Esta categoría todavía no tiene productos. Agregá el primero con el botón de arriba.</p>
        <% } %>
        <div class="productos">
          <% abierta.productos.forEach(function (p) { %>
            <%- include('_tarjeta', { p, categoria: abierta.id_categoria }) %>
          <% }) %>
        </div>
      <% } %>
    </section>

    <aside class="panel pedido">
      <div class="cabecera-pedido">
        <h2>Pedido</h2>
        <% if (lineas.length > 0) { %>
          <%# Vaciar el pedido: un basurero arriba a la derecha. %>
          <form method="post" action="/ventas/pedido">
            <input type="hidden" name="id_sucursal" value="<%= elegida %>">
            <input type="hidden" name="categoria" value="<%= abierta ? abierta.id_categoria : '' %>">
            <input type="hidden" name="busqueda" value="<%= busqueda %>">
            <button class="vaciar-pedido" type="submit" name="accion" value="vaciar"
                    title="Vaciar el pedido" aria-label="Vaciar el pedido">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 7h16"/><path d="M10 11v6M14 11v6"/>
                <path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12"/>
                <path d="M9 7V4h6v3"/>
              </svg>
            </button>
          </form>
        <% } %>
      </div>

      <% if (lineas.length === 0) { %>
        <p class="ayuda">Tocá un producto para sumarlo al pedido.</p>
      <% } else { %>
        <table class="tabla">
          <tbody>
            <% lineas.forEach(function (l) { %>
              <tr>
                <td>
                  <%= l.nombre %>
                  <div class="cantidad">
                    <form method="post" action="/ventas/pedido">
                      <input type="hidden" name="id_sucursal" value="<%= elegida %>">
                      <input type="hidden" name="categoria" value="<%= abierta ? abierta.id_categoria : '' %>">
                      <input type="hidden" name="busqueda" value="<%= busqueda %>">
                      <input type="hidden" name="id_producto" value="<%= l.id_producto %>">
                      <button class="boton-secundario" type="submit" name="accion" value="restar" aria-label="Uno menos">−</button>
                      <span><%= l.cantidad %></span>
                      <button class="boton-secundario" type="submit" name="accion" value="agregar" aria-label="Uno más">+</button>
                      <button class="enlace" type="submit" name="accion" value="quitar">Quitar</button>
                    </form>
                  </div>
                </td>
                <td class="numero"><%= pesos(l.subtotal) %></td>
              </tr>
            <% }) %>
            <tr class="destacada">
              <th>Total</th>
              <td class="numero"><%= pesos(total) %></td>
            </tr>
          </tbody>
        </table>

        <form method="post" action="/ventas/cobrar">
          <input type="hidden" name="id_sucursal" value="<%= elegida %>">
          <input type="hidden" name="categoria" value="<%= abierta ? abierta.id_categoria : '' %>">

          <%# Botones uno al lado del otro en vez de listas: se elige de un toque.
              Por debajo son opciones (radio), asi que el servidor recibe lo mismo. %>
          <fieldset class="opciones-boton">
            <legend>Por dónde fue la venta</legend>
            <div class="grupo-botones">
              <% CANALES.forEach(function (c) { %>
                <label class="opcion-boton">
                  <input type="radio" name="canal" value="<%= c.valor %>" <%= c.valor === canal ? 'checked' : '' %> required>
                  <span><%= c.texto %></span>
                </label>
              <% }) %>
            </div>
          </fieldset>

          <fieldset class="opciones-boton" id="medio-pago">
            <legend>Con qué pagó</legend>
            <div class="grupo-botones">
              <% medios.forEach(function (m) { %>
                <label class="opcion-boton">
                  <input type="radio" name="id_medio_pago" value="<%= m.id_medio_pago %>" <%= String(m.id_medio_pago) === medio ? 'checked' : '' %> required>
                  <span><%= m.nombre %></span>
                </label>
              <% }) %>
              <label class="opcion-boton">
                <input type="radio" name="id_medio_pago" value="<%= VARIOS_MEDIOS %>" <%= medio === VARIOS_MEDIOS ? 'checked' : '' %>>
                <span>Varios medios</span>
              </label>
            </div>
          </fieldset>

          <div id="pago-varios" class="pago-varios" data-total="<%= Math.round(total * 100) %>"
               <%= medio === VARIOS_MEDIOS ? '' : 'hidden' %>>
            <p class="pista">Poné cuánto se pagó con cada medio. Tiene que sumar <%= pesos(total) %>.</p>
            <% medios.forEach(function (m) { %>
              <label class="linea-pago">
                <span><%= m.nombre %></span>
                <input type="text" inputmode="decimal" autocomplete="off" class="dinero" name="monto_<%= m.id_medio_pago %>"
                       value="<%= montos[m.id_medio_pago] || '' %>" placeholder="$0" onfocus="this.select()">
              </label>
            <% }) %>
            <p id="falta-pagar" class="falta-pagar" aria-live="polite"></p>
          </div>

          <button class="boton" type="submit">Cobrar <%= pesos(total) %></button>
        </form>

      <% } %>
    </aside>
  </div>

  <section class="panel">
    <h2>Últimas ventas del turno</h2>
    <% if (ultimas.length === 0) { %>
      <p class="ayuda">Todavía no hay ventas en este turno.</p>
    <% } else { %>
      <table class="tabla">
        <thead>
          <tr>
            <th>Hora</th>
            <th>Canal</th>
            <th>Pago</th>
            <th class="numero">Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% ultimas.forEach(function (v) { %>
            <tr class="<%= v.anulada ? 'anulada' : '' %>">
              <td><%= v.fecha_hora.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) %></td>
              <td><%= (CANALES.find(function (c) { return c.valor === v.canal_venta; }) || {}).texto %></td>
              <td><%= v.medios || 'Sin pago' %></td>
              <td class="numero"><span class="monto"><%= pesos(Number(v.total)) %></span></td>
              <td class="acciones">
                <% if (v.anulada) { %>
                  <span class="marca-anulada">Anulada</span>
                  <span class="motivo">Anuló <%= v.anulo %>: <%= v.motivo_anulacion %></span>
                <% } else { %>
                  <a class="enlace" href="/ventas/<%= v.id_venta %>/anular">Anular</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
<% } %>

<script>
  // Filtra los productos de la categoria mientras se escribe. Si el
  // navegador no corre JavaScript no pasa nada: se ven todos, como antes.
  (function () {
    var campo = document.getElementById('buscar-producto');
    if (!campo) return;

    // Sin acentos y en minuscula, asi "cafe" encuentra "Café".
    function normalizar(texto) {
      return texto.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }

    var tarjetas = document.querySelectorAll('form.producto');
    var sinResultados = document.getElementById('sin-resultados');

    function filtrar() {
      // Cada palabra tiene que aparecer en el nombre, en cualquier orden:
      // "choco blanco" encuentra "Alfajor chocolate blanco con nuez".
      var palabras = normalizar(campo.value).split(/\s+/).filter(Boolean);
      var visibles = 0;
      tarjetas.forEach(function (tarjeta) {
        var nombre = normalizar(tarjeta.dataset.nombre);
        var coincide = palabras.every(function (p) { return nombre.indexOf(p) !== -1; });
        tarjeta.hidden = !coincide;
        if (coincide) visibles += 1;
      });
      sinResultados.hidden = visibles > 0;

      // Viaja con cada boton del pedido, para que al volver siga filtrado.
      document.querySelectorAll('input[name="busqueda"]').forEach(function (oculto) {
        oculto.value = campo.value;
      });
    }

    campo.addEventListener('input', filtrar);
    filtrar();
  })();

  // Busqueda general del inicio de Vender: mientras haya algo escrito se
  // esconden "Lo mas vendido" y las categorias, y se ven los productos que
  // coinciden (por nombre o categoria, sin importar acentos ni el orden de
  // las palabras). La busqueda viaja con cada boton para que, al volver
  // despues de sumar un producto, siga filtrado.
  (function () {
    var campo = document.getElementById('buscar-todo');
    if (!campo) return;
    var inicio = document.getElementById('inicio-vender');
    var resultados = document.getElementById('resultados-busqueda');
    var tarjetas = resultados.querySelectorAll('form.producto');
    var sinResultados = document.getElementById('sin-resultados-todo');
    function normalizar(texto) { return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); }
    function filtrar() {
      var palabras = normalizar(campo.value).split(/\s+/).filter(Boolean);
      var buscando = palabras.length > 0;
      inicio.hidden = buscando;
      resultados.hidden = !buscando;
      var visibles = 0;
      tarjetas.forEach(function (t) {
        var nombre = normalizar(t.dataset.nombre);
        var coincide = buscando && palabras.every(function (p) { return nombre.indexOf(p) !== -1; });
        t.hidden = !coincide;
        if (coincide) visibles += 1;
      });
      sinResultados.hidden = !buscando || visibles > 0;
      document.querySelectorAll('input[name="busqueda"]').forEach(function (oculto) { oculto.value = campo.value; });
    }
    campo.addEventListener('input', filtrar);
    filtrar();
  })();

  // Pago con varios medios: muestra los montos solo cuando se elige esa
  // opcion, y va diciendo cuanto falta o sobra para llegar al total. La
  // cuenta de verdad la vuelve a hacer el servidor al cobrar.
  (function () {
    var selector = document.getElementById('medio-pago');
    var bloque = document.getElementById('pago-varios');
    if (!selector || !bloque) return;
    var opciones = selector.querySelectorAll('input[name="id_medio_pago"]');

    var total = Number(bloque.dataset.total);
    var aviso = document.getElementById('falta-pagar');
    var campos = bloque.querySelectorAll('input');

    var pesos = window.dineroKokino.pesos;

    function actualizar() {
      var elegida = selector.querySelector('input[name="id_medio_pago"]:checked');
      var varios = Boolean(elegida) && elegida.value === '<%= VARIOS_MEDIOS %>';
      bloque.hidden = !varios;
      if (!varios) return;
      var pagado = 0;
      campos.forEach(function (c) { pagado += window.dineroKokino.centavos(c.value); });
      var diferencia = total - pagado;
      aviso.textContent = diferencia === 0 ? 'Cubre el total.'
        : diferencia > 0 ? 'Faltan ' + pesos(diferencia) + '.'
        : 'Sobran ' + pesos(-diferencia) + '.';
      aviso.className = 'falta-pagar' + (diferencia === 0 ? ' completo' : '');
    }

    opciones.forEach(function (o) { o.addEventListener('change', actualizar); });
    campos.forEach(function (c) { c.addEventListener('input', actualizar); });
    actualizar();
  })();
</script>

<%- include('../parciales/pie') %>
