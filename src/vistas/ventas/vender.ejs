<%- include('../parciales/encabezado', { titulo: 'Vender - Kokino' }) %>
<%
  // Un icono por categoria, con el mismo trazo que el menu. Van por nombre
  // porque las categorias las carga una migracion y casi no cambian; una
  // categoria nueva aparece con el generico hasta que se le dibuje el suyo.
  const trazos = {
    'Cafetería': '<path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M17 10.5h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3.5v2.5M12.5 3.5v2.5"/>',
    'Cucuruchos': '<circle cx="12" cy="8" r="4.5"/><path d="M7.9 10.2 12 21l4.1-10.8"/><path d="M9.5 14h5"/>',
    'Familiar': '<path d="M4 8.5h16"/><path d="M5.5 8.5 7 20h10l1.5-11.5"/><path d="M6.5 8.5c0-2.5 2.5-4 5.5-4s5.5 1.5 5.5 4"/>',
    'Impulsivos': '<rect x="7" y="3" width="10" height="13" rx="5"/><path d="M12 16v5"/><path d="M10 7.5v4"/>',
    'Línea diet': '<path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14z"/><path d="M5 19l8-8"/>',
    'Repostería': '<path d="M4 20h16v-7H4z"/><path d="M4 16c2 1.5 4 1.5 6 0s4-1.5 6 0 3 1 4 0"/><path d="M12 13V9.5"/><path d="M12 7c.9-.9.9-1.9 0-3-.9 1.1-.9 2.1 0 3z"/>',
    'Salsas': '<path d="M12 3c3 4.5 6 7.8 6 11a6 6 0 0 1-12 0c0-3.2 3-6.5 6-11z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>',
    'Térmicos': '<rect x="6" y="7" width="12" height="14" rx="2"/><path d="M5 7h14"/><path d="M9.5 3.5h5V7h-5z"/><path d="M9 12h6"/>',
  };
  const generico = '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>';
  const iconoCategoria = (nombre) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + (trazos[nombre] || generico) + '</svg>';
%>

<h1>Vender</h1>

<% if (sucursales.length > 1) { %>
  <form class="filtro" method="get" action="/ventas">
    <label>
      Sucursal
      <select name="sucursal" onchange="this.form.submit()">
        <% sucursales.forEach(function (s) { %>
          <option value="<%= s.id_sucursal %>" <%= s.id_sucursal === elegida ? 'selected' : '' %>>
            <%= s.nombre %>
          </option>
        <% }) %>
      </select>
    </label>
    <noscript><button type="submit">Ver</button></noscript>
  </form>
<% } %>

<% if (errores.length > 0) { %>
  <ul class="errores">
    <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<% if (!caja) { %>
  <section class="panel">
    <h2>No hay caja abierta</h2>
    <p class="ayuda">
      Para vender tiene que haber una caja abierta en esta sucursal: cada venta
      queda registrada en el turno de una caja.
    </p>
    <a class="boton" href="/caja?sucursal=<%= elegida %>">Ir a abrir la caja</a>
  </section>
<% } else { %>
  <div class="venta">
    <section class="catalogo-venta">
      <% if (!abierta) { %>
        <h2>¿Qué va a llevar?</h2>
        <div class="categorias">
          <% catalogo.forEach(function (grupo) { %>
            <a class="categoria" href="/ventas?sucursal=<%= elegida %>&categoria=<%= grupo.id_categoria %>">
              <span class="icono-categoria"><%- iconoCategoria(grupo.categoria) %></span>
              <span class="nombre-categoria"><%= grupo.categoria %></span>
              <span class="cuantos"><%= grupo.productos.length %> producto<%= grupo.productos.length === 1 ? '' : 's' %></span>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="titulo-categoria">
          <a class="volver" href="/ventas?sucursal=<%= elegida %>">← Categorías</a>
          <h2>
            <span class="icono-categoria chico"><%- iconoCategoria(abierta.categoria) %></span>
            <%= abierta.categoria %>
          </h2>
          <input type="search" id="buscar-producto" class="buscar" value="<%= busqueda %>"
                 placeholder="Buscar en <%= abierta.categoria %> por nombre"
                 aria-label="Buscar producto por nombre" autocomplete="off">
        </div>
        <p id="sin-resultados" class="ayuda" hidden>Ningún producto de esta categoría coincide con la búsqueda.</p>
        <div class="productos">
          <% abierta.productos.forEach(function (p) { %>
            <form class="producto" method="post" action="/ventas/pedido" data-nombre="<%= p.nombre %>">
              <input type="hidden" name="id_sucursal" value="<%= elegida %>">
              <input type="hidden" name="categoria" value="<%= abierta.id_categoria %>">
              <input type="hidden" name="busqueda" value="<%= busqueda %>">
              <input type="hidden" name="id_producto" value="<%= p.id_producto %>">
              <span class="nombre-producto"><%= p.nombre %></span>
              <span class="precio-producto">$<%= Number(p.precio).toFixed(2) %></span>
              <div class="agregar">
                <input type="number" name="cantidad" value="1" min="1" max="<%= CANTIDAD_MAXIMA %>"
                       step="1" inputmode="numeric" aria-label="Cantidad de <%= p.nombre %>"
                       onfocus="this.select()">
                <button type="submit" name="accion" value="agregar">Agregar</button>
              </div>
            </form>
          <% }) %>
        </div>
      <% } %>
    </section>

    <aside class="panel pedido">
      <h2>Pedido</h2>

      <% if (lineas.length === 0) { %>
        <p class="ayuda">Tocá un producto para sumarlo al pedido.</p>
      <% } else { %>
        <table class="tabla">
          <tbody>
            <% lineas.forEach(function (l) { %>
              <tr>
                <td>
                  <%= l.nombre %>
                  <div class="cantidad">
                    <form method="post" action="/ventas/pedido">
                      <input type="hidden" name="id_sucursal" value="<%= elegida %>">
                      <input type="hidden" name="categoria" value="<%= abierta ? abierta.id_categoria : '' %>">
                      <input type="hidden" name="busqueda" value="<%= busqueda %>">
                      <input type="hidden" name="id_producto" value="<%= l.id_producto %>">
                      <button class="boton-secundario" type="submit" name="accion" value="restar" aria-label="Uno menos">−</button>
                      <span><%= l.cantidad %></span>
                      <button class="boton-secundario" type="submit" name="accion" value="agregar" aria-label="Uno más">+</button>
                      <button class="enlace" type="submit" name="accion" value="quitar">Quitar</button>
                    </form>
                  </div>
                </td>
                <td class="numero">$<%= l.subtotal.toFixed(2) %></td>
              </tr>
            <% }) %>
            <tr class="destacada">
              <th>Total</th>
              <td class="numero">$<%= total.toFixed(2) %></td>
            </tr>
          </tbody>
        </table>

        <form method="post" action="/ventas/cobrar">
          <input type="hidden" name="id_sucursal" value="<%= elegida %>">
          <input type="hidden" name="categoria" value="<%= abierta ? abierta.id_categoria : '' %>">

          <label>
            Por dónde fue la venta
            <select name="canal" required>
              <% CANALES.forEach(function (c) { %>
                <option value="<%= c.valor %>" <%= c.valor === canal ? 'selected' : '' %>><%= c.texto %></option>
              <% }) %>
            </select>
          </label>

          <label>
            Con qué pagó
            <select name="id_medio_pago" id="medio-pago" required>
              <% medios.forEach(function (m) { %>
                <option value="<%= m.id_medio_pago %>" <%= String(m.id_medio_pago) === medio ? 'selected' : '' %>><%= m.nombre %></option>
              <% }) %>
              <option value="<%= VARIOS_MEDIOS %>" <%= medio === VARIOS_MEDIOS ? 'selected' : '' %>>Varios medios</option>
            </select>
          </label>

          <div id="pago-varios" class="pago-varios" data-total="<%= Math.round(total * 100) %>"
               <%= medio === VARIOS_MEDIOS ? '' : 'hidden' %>>
            <p class="pista">Poné cuánto se pagó con cada medio. Tiene que sumar $<%= total.toFixed(2) %>.</p>
            <% medios.forEach(function (m) { %>
              <label class="linea-pago">
                <span><%= m.nombre %></span>
                <input type="number" name="monto_<%= m.id_medio_pago %>" step="0.01" min="0"
                       value="<%= montos[m.id_medio_pago] || '' %>" placeholder="0.00" onfocus="this.select()">
              </label>
            <% }) %>
            <p id="falta-pagar" class="falta-pagar" aria-live="polite"></p>
          </div>

          <button class="boton" type="submit">Cobrar $<%= total.toFixed(2) %></button>
        </form>

        <form method="post" action="/ventas/pedido">
          <input type="hidden" name="id_sucursal" value="<%= elegida %>">
          <input type="hidden" name="categoria" value="<%= abierta ? abierta.id_categoria : '' %>">
          <input type="hidden" name="busqueda" value="<%= busqueda %>">
          <button class="enlace" type="submit" name="accion" value="vaciar">Vaciar el pedido</button>
        </form>
      <% } %>
    </aside>
  </div>

  <section class="panel">
    <h2>Últimas ventas del turno</h2>
    <% if (ultimas.length === 0) { %>
      <p class="ayuda">Todavía no hay ventas en este turno.</p>
    <% } else { %>
      <table class="tabla">
        <thead>
          <tr>
            <th>Hora</th>
            <th>Canal</th>
            <th>Pago</th>
            <th class="numero">Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% ultimas.forEach(function (v) { %>
            <tr class="<%= v.anulada ? 'anulada' : '' %>">
              <td><%= v.fecha_hora.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) %></td>
              <td><%= (CANALES.find(function (c) { return c.valor === v.canal_venta; }) || {}).texto %></td>
              <td><%= v.medios || 'Sin pago' %></td>
              <td class="numero"><span class="monto">$<%= Number(v.total).toFixed(2) %></span></td>
              <td class="acciones">
                <% if (v.anulada) { %>
                  <span class="marca-anulada">Anulada</span>
                  <span class="motivo">Anuló <%= v.anulo %>: <%= v.motivo_anulacion %></span>
                <% } else { %>
                  <a class="enlace" href="/ventas/<%= v.id_venta %>/anular">Anular</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
<% } %>

<script>
  // Filtra los productos de la categoria mientras se escribe. Si el
  // navegador no corre JavaScript no pasa nada: se ven todos, como antes.
  (function () {
    var campo = document.getElementById('buscar-producto');
    if (!campo) return;

    // Sin acentos y en minuscula, asi "cafe" encuentra "Café".
    function normalizar(texto) {
      return texto.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }

    var tarjetas = document.querySelectorAll('form.producto');
    var sinResultados = document.getElementById('sin-resultados');

    function filtrar() {
      // Cada palabra tiene que aparecer en el nombre, en cualquier orden:
      // "choco blanco" encuentra "Alfajor chocolate blanco con nuez".
      var palabras = normalizar(campo.value).split(/\s+/).filter(Boolean);
      var visibles = 0;
      tarjetas.forEach(function (tarjeta) {
        var nombre = normalizar(tarjeta.dataset.nombre);
        var coincide = palabras.every(function (p) { return nombre.indexOf(p) !== -1; });
        tarjeta.hidden = !coincide;
        if (coincide) visibles += 1;
      });
      sinResultados.hidden = visibles > 0;

      // Viaja con cada boton del pedido, para que al volver siga filtrado.
      document.querySelectorAll('input[name="busqueda"]').forEach(function (oculto) {
        oculto.value = campo.value;
      });
    }

    campo.addEventListener('input', filtrar);
    filtrar();
  })();

  // Pago con varios medios: muestra los montos solo cuando se elige esa
  // opcion, y va diciendo cuanto falta o sobra para llegar al total. La
  // cuenta de verdad la vuelve a hacer el servidor al cobrar.
  (function () {
    var selector = document.getElementById('medio-pago');
    var bloque = document.getElementById('pago-varios');
    if (!selector || !bloque) return;

    var total = Number(bloque.dataset.total);
    var aviso = document.getElementById('falta-pagar');
    var campos = bloque.querySelectorAll('input');

    function pesos(centavos) { return '$' + (centavos / 100).toFixed(2); }

    function actualizar() {
      var varios = selector.value === '<%= VARIOS_MEDIOS %>';
      bloque.hidden = !varios;
      if (!varios) return;
      var pagado = 0;
      campos.forEach(function (c) { pagado += Math.round(Number(c.value || 0) * 100); });
      var diferencia = total - pagado;
      aviso.textContent = diferencia === 0 ? 'Cubre el total.'
        : diferencia > 0 ? 'Faltan ' + pesos(diferencia) + '.'
        : 'Sobran ' + pesos(-diferencia) + '.';
      aviso.className = 'falta-pagar' + (diferencia === 0 ? ' completo' : '');
    }

    selector.addEventListener('change', actualizar);
    campos.forEach(function (c) { c.addEventListener('input', actualizar); });
    actualizar();
  })();
</script>

<%- include('../parciales/pie') %>
