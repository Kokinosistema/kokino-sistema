<%- include('../parciales/encabezado', { titulo: 'Fabricación - Kokino' }) %>

<h1>Fabricación</h1>

<% if (errores.length > 0) { %>
  <ul class="errores" role="alert">
    <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<% if (puedeProducir) { %>
  <section class="panel">
    <h2>Registrar producción</h2>
    <p class="ayuda">
      El helado se carga en tachos de <%= LITROS_POR_TACHO %> litros; los impulsivos y la
      repostería propia, en unidades. Lo producido suma al stock de <strong><%= sucursal.nombre %></strong>.
    </p>
    <form method="post" action="/fabricacion/produccion" class="formulario">
      <input type="hidden" name="id_sucursal" value="<%= sucursal.id_sucursal %>">
      <div class="fila">
        <div>
          <label for="fecha">Día</label>
          <input id="fecha" name="fecha" type="date" required max="<%= hoy %>" value="<%= elegido.fecha %>">
        </div>
        <div class="campo-ancho">
          <label for="que-texto">Qué se produjo</label>
          <%# Lista propia en vez de un select: el navegador abre los select para
              arriba cuando queda poco lugar abajo, y esta siempre se abre para
              abajo. El texto busca; la flecha abre y cierra la lista. %>
          <% let nombreElegido = '';
             opciones.forEach(function (g) { g.opciones.forEach(function (o) { if (o.valor === elegido.que) nombreElegido = o.nombre; }); }); %>
          <div class="combo" id="combo-produccion">
            <input type="hidden" name="que" id="que" value="<%= nombreElegido ? elegido.que : '' %>">
            <input type="text" id="que-texto" class="combo-texto" autocomplete="off"
                   role="combobox" aria-expanded="false" aria-controls="que-lista" aria-autocomplete="list"
                   placeholder="Buscá el sabor o el producto (por ejemplo: dulce nuez)" value="<%= nombreElegido %>">
            <button type="button" class="combo-flecha" aria-label="Mostrar la lista de sabores y productos">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <ul id="que-lista" class="combo-lista" role="listbox" hidden>
              <% opciones.forEach(function (g, i) { %>
                <li class="combo-grupo" role="presentation"><%= g.nombre %></li>
                <% g.opciones.forEach(function (o, j) { %>
                  <li class="combo-opcion" role="option" id="opcion-<%= i %>-<%= j %>" aria-selected="false"
                      data-valor="<%= o.valor %>" data-unidad="<%= o.unidad %>" data-grupo="<%= g.nombre %>"><%= o.nombre %></li>
                <% }) %>
              <% }) %>
              <li class="combo-vacio" role="presentation" hidden>Ningún sabor ni producto coincide con la búsqueda.</li>
            </ul>
          </div>
        </div>
        <div>
          <label for="cantidad">Cantidad <span id="unidad-cantidad" class="pista-inline"></span></label>
          <input id="cantidad" name="cantidad" class="solo-numeros" inputmode="numeric" maxlength="3" required
                 data-mensaje="la cantidad es un número entero." autocomplete="off" value="<%= elegido.cantidad %>" placeholder="Por ejemplo: 3">
        </div>
      </div>
      <button type="submit">Registrar</button>
    </form>
  </section>
<% } else { %>
  <p class="ayuda">
    La producción se registra en la sucursal donde está la fábrica. Acá ves el stock de
    helado de <strong><%= sucursal.nombre %></strong> y cambiás los tachos que se terminan.
  </p>
<% } %>

<section class="panel">
  <h2>Stock de helado en <%= sucursal.nombre %></h2>
  <p class="ayuda">
    Cuando se termina el tacho de un sabor, tocá <strong>Cambiar tacho</strong>: el que estaba
    en el pozo queda vacío y se abre el lleno que vence primero.
  </p>
  <% if (stock.length === 0) { %>
    <p class="ayuda">Todavía no hay tachos de helado en esta sucursal.</p>
  <% } else { %>
    <table class="tabla">
      <thead>
        <tr>
          <th>Sabor</th>
          <th class="numero">En el pozo</th>
          <th class="numero">Llenos</th>
          <th class="numero">Litros</th>
          <th>Próximo en vencer</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% stock.forEach(function (s) { %>
          <tr>
            <td><%= s.sabor %></td>
            <td class="numero"><%= s.en_pozo %></td>
            <td class="numero <%= s.llenos === 0 ? 'alerta' : '' %>"><%= s.llenos %></td>
            <td class="numero"><%= Number(s.litros) %> L</td>
            <td><%= s.proximo_vencimiento ? s.proximo_vencimiento.toLocaleDateString('es-AR') : '—' %></td>
            <td class="acciones">
              <form method="post" action="/fabricacion/cambiar-tacho">
                <input type="hidden" name="id_sucursal" value="<%= sucursal.id_sucursal %>">
                <input type="hidden" name="id_sabor" value="<%= s.id_sabor %>">
                <button class="enlace" type="submit"><%= s.en_pozo > 0 ? 'Cambiar tacho' : 'Abrir tacho' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<% if (puedeProducir) { %>
  <section class="panel">
    <h2>Últimas producciones</h2>
    <% if (historial.length === 0) { %>
      <p class="ayuda">Todavía no se registró ninguna producción.</p>
    <% } else { %>
      <table class="tabla">
        <thead>
          <tr>
            <th>Día</th>
            <th>Qué</th>
            <th class="numero">Cantidad</th>
            <th>Receta</th>
            <th>Cargó</th>
          </tr>
        </thead>
        <tbody>
          <% historial.forEach(function (h) { %>
            <% const n = h.es_helado ? Number(h.cantidad_real) / LITROS_POR_TACHO : Number(h.cantidad_real); %>
            <tr>
              <td><%= h.fecha_produccion.toLocaleDateString('es-AR') %></td>
              <td><%= h.que %></td>
              <td class="numero"><%= n %> <%= h.es_helado ? (n === 1 ? 'tacho' : 'tachos') : h.unidad %></td>
              <td><%= h.es_pote ? 'No lleva' : (h.con_receta ? 'Sí' : 'Sin receta: no descontó insumos') %></td>
              <td><%= h.quien %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
<% } %>

<script src="/solo-numeros.js"></script>
<script>
  // Lista de "Que se produjo". Siempre se abre para abajo (es una lista
  // propia, no un select). La flecha la abre y la cierra; tocar el texto no
  // la abre, pero escribir si, con lo que coincide: sin importar acentos ni
  // mayusculas, y con cada palabra en cualquier orden ("dulce nuez"
  // encuentra "Dulce de leche con nuez"). Se elige con un clic o con Enter, y
  // al elegir se pasa a la cantidad. Lo que se envia es el valor del campo
  // oculto "que": si se cambia el texto sin elegir, queda vacio y el servidor
  // pide elegir.
  (function () {
    var combo = document.getElementById('combo-produccion');
    if (!combo) return;
    var oculto = document.getElementById('que');
    var texto = document.getElementById('que-texto');
    var flecha = combo.querySelector('.combo-flecha');
    var lista = document.getElementById('que-lista');
    var vacio = lista.querySelector('.combo-vacio');
    var unidad = document.getElementById('unidad-cantidad');
    var cantidad = document.getElementById('cantidad');
    var opciones = Array.prototype.slice.call(lista.querySelectorAll('.combo-opcion'));
    var grupos = lista.querySelectorAll('.combo-grupo');
    var activa = -1;

    function normalizar(t) { return t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); }
    function visibles() { return opciones.filter(function (o) { return !o.hidden; }); }
    function elegida() { return opciones.find(function (o) { return o.dataset.valor === oculto.value; }); }

    // Al lado de "Cantidad": tachos de 10 L para el helado, unidades para los productos.
    function mostrarUnidad() {
      var o = elegida();
      unidad.textContent = o ? '(' + o.dataset.unidad + ')' : '';
    }

    function filtrar(consulta) {
      var palabras = normalizar(consulta).split(/\s+/).filter(Boolean);
      opciones.forEach(function (o) {
        var nombre = normalizar(o.textContent + ' ' + o.dataset.grupo);
        o.hidden = !palabras.every(function (p) { return nombre.indexOf(p) !== -1; });
      });
      // El titulo de un grupo se ve solo si le queda alguna opcion a la vista.
      grupos.forEach(function (g) {
        var sig = g.nextElementSibling, alguna = false;
        while (sig && !sig.classList.contains('combo-grupo')) {
          if (sig.classList.contains('combo-opcion') && !sig.hidden) alguna = true;
          sig = sig.nextElementSibling;
        }
        g.hidden = !alguna;
      });
      vacio.hidden = visibles().length > 0;
      marcar(visibles().length > 0 ? 0 : -1);
    }

    function marcar(i) {
      var v = visibles();
      opciones.forEach(function (o) { o.classList.remove('activa'); o.setAttribute('aria-selected', 'false'); });
      activa = i;
      if (i >= 0 && v[i]) {
        v[i].classList.add('activa');
        v[i].setAttribute('aria-selected', 'true');
        texto.setAttribute('aria-activedescendant', v[i].id);
        v[i].scrollIntoView({ block: 'nearest' });
      } else {
        texto.removeAttribute('aria-activedescendant');
      }
    }

    function abrir() {
      lista.hidden = false;
      combo.classList.add('abierto');
      texto.setAttribute('aria-expanded', 'true');
    }
    function cerrar() {
      lista.hidden = true;
      combo.classList.remove('abierto');
      texto.setAttribute('aria-expanded', 'false');
    }

    function elegir(o) {
      oculto.value = o.dataset.valor;
      texto.value = o.textContent.trim();
      cerrar();
      mostrarUnidad();
      cantidad.focus();
    }

    // La flecha abre y cierra. Si el texto es el de lo ya elegido, muestra
    // la lista entera; si no, lo que coincide con lo escrito.
    flecha.addEventListener('mousedown', function (e) { e.preventDefault(); });
    flecha.addEventListener('click', function () {
      if (!lista.hidden) { cerrar(); return; }
      var o = elegida();
      filtrar(o && texto.value === o.textContent.trim() ? '' : texto.value);
      abrir();
      texto.focus();
    });

    // Al tocar el texto se selecciona entero: si ya habia algo elegido, lo
    // que se escribe lo reemplaza en vez de mezclarse con el nombre anterior.
    texto.addEventListener('focus', function () { texto.select(); });

    texto.addEventListener('input', function () {
      oculto.value = '';
      mostrarUnidad();
      filtrar(texto.value);
      abrir();
    });

    texto.addEventListener('keydown', function (e) {
      var v = visibles();
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (lista.hidden) { filtrar(elegida() ? '' : texto.value); abrir(); } else marcar(Math.min(activa + 1, v.length - 1));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (!lista.hidden) marcar(Math.max(activa - 1, 0));
      } else if (e.key === 'Enter') {
        // Enter elige la marcada (la primera que coincide) en vez de enviar.
        e.preventDefault();
        if (!lista.hidden && v[activa]) elegir(v[activa]);
        else if (oculto.value) cantidad.focus();
        else { filtrar(texto.value); if (visibles()[0]) elegir(visibles()[0]); }
      } else if (e.key === 'Escape') {
        cerrar();
      }
    });

    lista.addEventListener('mousedown', function (e) { e.preventDefault(); });
    lista.addEventListener('click', function (e) {
      var o = e.target.closest('.combo-opcion');
      if (o) elegir(o);
    });
    document.addEventListener('click', function (e) { if (!combo.contains(e.target)) cerrar(); });

    mostrarUnidad();
  })();
</script>

<%- include('../parciales/pie') %>
