{
  "name": "kokino-sistema",
  "version": "1.0.0",
  "description": "Sistema de gestión propio para la heladería Kokino (San Miguel de Tucumán, Argentina), pensado para reemplazar el POS actual (Fudo). Es el Trabajo de Campo de la carrera.",
  "main": "server.js",
  "scripts": {
    "test": "node --env-file=.env test/preparar-base.js && node --env-file=.env --test --test-concurrency=1 \"test/*.test.js\"",
    "migrate:create": "node-pg-migrate create -j sql --",
    "migrate:up": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env",
    "seed:precios": "node --env-file=.env seeds/precios.js",
    "seed:precios-mayoristas": "node --env-file=.env seeds/precios_mayoristas.js",
    "seed:costos":"node --env-file=.env seeds/costos.js",
    "seed:costos-insumo": "node --env-file=.env seeds/costos_insumo.js",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "crear-usuario": "node --env-file-if-exists=.env scripts/crear-usuario.js",
    "copia": "node --env-file=.env scripts/copia-de-seguridad.js",
    "demo:cargar": "node --env-file=.env scripts/datos-demo.js cargar",
    "demo:borrar": "node --env-file=.env scripts/datos-demo.js borrar"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "dotenv": "^17.4.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  }
}
